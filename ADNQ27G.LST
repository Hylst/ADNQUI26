' ADN QUIZZ - GUESS TITLE FROM MUSIC
' HYLST + DEBUG : TOMCHI & DMA SC
' affichage test clippe,auto centre,font mono (avec possib de det couleur optimale visib) ou couleur, outline software possible
' So many strange errors
' Retropedalage, trop de bugs, rappel version de base
' Modifs faciles en cas de prob de contraste pour la police avec rc copy mode
' Checklist : UnPixelate, Scrambling, Fadeon/off, Sndh player renew, file loading, text display
$m 450000 ! memory need for the program 2 be compiled arrays & strings - OR RESERVE...
.
.
@hello
@get_slide_filenames
@base_files_load
@clearpal
@pmul160 ! precalc 160*y&
@prepfont(FALSE) ! prepare font for display (4 colours or mono)
@set_text_colors ! pick ink/box colours from the intro picture palette
@sndh(tune%)
@screen.opening(pic%)
@intro_quizz
@quizz
@bye
.
.
'  !>
PROCEDURE hello
  .
  ' compiler options
  ' $I- ! disable interrupt routine  -  $I+{ would enable them
  ' $N- ! Disable FOR-NEXT range checking
  ' $S> ! Fast select case  -  $C< slower but shorter code
  ' $*& ! Longword multiplication with muls  -  $*% :  without
  ' $%3 ! Always execute integer division as an integer division  -   $%0 = opposite
  '
  ' ***********************************************************************************************
  compiled!=BYTE{BASEPAGE+256}<>96  ! false=interpreted/true=compiled
  ' NE PAS remettre le IF NOT compiled! autour de RESERVE :
  ' RESERVE libere la memoire au dela de 400000 vers GEMDOS, et le
  ' MALLOC juste en dessous (environ 488000) depend de cette liberation.
  ' Sans RESERVE en compile, le MALLOC echoue et on tombe dans EDIT
  ' donc sortie immediate, ecran noir.
  ' IF NOT compiled!
  RESERVE 400000! 65536 ! if interpreted
  ' ENDIF
  ' reserve memory for double screen buffer, for void + current + save palette, 22 free lines for lowborder font mask, space for current pic 2 display
  ' NB: le tampon musique (200000) est ajoute plus bas, APRES le calcul des fichiers de base,
  ' pour que tune% ne chevauche plus sndhplay%/sp3%/font% (bug corrige : voir plus bas)
  total_size%=32256+32+32+32+(22+8)*160+32034+16*160
  .
  .///////////////////////////////////
  ' @calc_needed_memory(total_size%)
  ' Calc buffer space needed for base files loading
  .
  RESTORE base.files
  READ nb_files& ! number of base files to load
  DEC nb_files&
  DIM file_name$(nb_files&),cumul_size%(nb_files&)
  FOR file&=0 TO nb_files&
    READ fname$
    file_name$(file&)=fname$ ! mypath$+fname$
    OPEN "I",#1,file_name$(file&)
    length%=LOF(#1)
    cumul_size%(file&)=total_size%
    ADD total_size%,length%
    CLOSE #1
  NEXT file&
  ' tampon musique (tune%) ajoute ICI, apres sndhplay%/sp3%/font%, pour ne plus les chevaucher
  ADD total_size%,200000
  ADD total_size%,66*160 ! fonte 16x22 du scrolltext d'intro
  .///////////////////////////////////
  .
  ' +256 : log% arrondit mem_block% vers le HAUT (video shifter), donc la derniere
  ' adresse utilisee est log%+total_size%, soit jusqu a 255 octets au dela de
  ' mem_block%+total_size%. Sans cette marge, on ecrit hors du bloc alloue.
  mem_block%=MALLOC(total_size%+256) ! reserve global buffer for all files & specific sub buffers for sequential memory attribution
  IF mem_block%<=0
    IF NOT compiled!
      RESERVE
    ENDIF
    EDIT
  ENDIF
  ' Set all needed buffers address from big malloc
  log%=(mem_block%+255) AND &HFFFFFF00 ! Stf compatible adress for video shifter
  ' MALLOC ne garantit PAS une memoire a zero : l'emulateur rend souvent des
  ' pages vierges, une vraie machine rend le contenu precedent. log% etait donc
  ' affiche brouille au premier stab, avant d'etre efface. C'est le candidat
  ' principal pour l'ecran brouille observe au demarrage sur ST reel.
  FOR fill%=log% TO log%+31996 STEP 4
    LONG{fill%}=0
  NEXT fill%
  pal%=log%+32256           ! current palette
  stzpal%=pal%+32           ! black palette
  savpal%=stzpal%+32        ! save palette
  lowborderm%=savpal%+32    ! 22 lignes lowborder or erase buffer
  fmask%=lowborderm%+22*160 ! 8 lines for mask for font display fx
  pic%=fmask%+8*160         ! buffer to load current picture 32000+34 (full pi1 - to remove once better load pi1 proc )
  bandsav%=pic%+32034       ! 16 lignes, sauvegarde du bas d'ecran pour @point
  ' tune% n'est PLUS ici (pic%+32034) : cette adresse tombait exactement sur sndhplay%,
  ' donc chaque chargement de musique (jusqu'a 75Ko observes) ecrasait le lecteur sndh
  ' et la fonte. tune% est maintenant defini plus bas, juste apres font%.
  ' Base log% et NON mem_block% : les tampons ecran ci-dessus partent de log%
  ' (arrondi) alors que ceux-ci partaient de mem_block% (non arrondi). Or
  ' cumul_size%(0) vaut exactement 69186, soit la longueur de la chaine ci-dessus.
  ' Les deux chaines n etaient donc jointives que si MALLOC retournait deja une
  ' adresse alignee sur 256 ; sinon la fin de pic% deborde de 0 a 255 octets sur
  ' le DEBUT de sndhplay%, qui ne fait que 186 octets, donc sur ses points d entree.
  ' Piste pour le symptome "pas de musique". Avec log% partout, les deux chaines
  ' sont jointives par construction, quelle que soit l adresse rendue par MALLOC.
  sndhplay%=log%+cumul_size%(0)         ! sndh player
  sp3%=log%+cumul_size%(1)              ! sp3 rout depacker
  font%=log%+cumul_size%(2)         ! 8x8x4c font 16*160
  fnt2%=font%+16*160 ! fonte 16x22, 3 rangees de 22 lignes
  tune%=fnt2%+66*160 ! buffer musique
  '
  '  ~GRAF_MOUSE(256,0) ! =OUT 4,18 hide mouse (hidem don't work with patched libs)
  OUT 4,18
  ' Saves
  oldrez&=XBIOS(4)  ! save reso
  oldlog%=XBIOS(3) ! save logical screen adress "NONONONONONONO"
  oldphy%=XBIOS(2) ! save logical screen adress
  phy%=oldphy%
  ~XBIOS(5,L:phy%,L:phy%,-1) ! set the screens at these new adresses in st low reso
  @super
  ./ create empty pal
  LONG{stzpal%+0}=0
  LONG{stzpal%+4}=0
  LONG{stzpal%+8}=0
  LONG{stzpal%+12}=0
  BMOVE stzpal%,stzpal%+16,16
  ./////////////////////////////////////
  ' DIM tableaux regroupees amont = limitation garbage collector or bugs with DIM in functions or procedures ??
  DIM regsndh%(16) ! Pour la routine SNDH player
  DIM r&(16),v&(16),b&(16),dr(16),dv(16),db(16) ! initial + final rvb components for fadeon/off procedure
  DIM ipal&(16) ! intermediate calculated pal
  '
  DIM vdicol|(16)
  '
  DIM lignes&(200) ! for text shuffle
  ' v 4 bombs executing this v why ?!! 64000<65536 !
  ' DIM pic_colors|(64000) ! for scan_pic_for_color ! je voulais l eviter, mais 4 bombes... pas de card ou long adr imp pourtant, plantage des lancment prog ??!!!
  DIM freq%(16) ! for scan_pic_for_color
  DIM pnh&(8),pnv&(8) ! taille de bloc horizontale / verticale par niveau
  DIM ordre&(1000) ! ordre de devoilement pour @random_pixels (2 Ko)
  DIM rcniv&(12) ! tailles de bloc de @dezoom.rc
  DIM sinus&(15) ! table d'ondulation du texte, cf. @display.bitmap.txt
  DIM fx&(63),fy&(63),fvx&(63),fvy&(63),fvie&(63) ! particules du feu d'artifice
  DIM epx&(1,63),epy&(1,63) ! positions dessinees, une generation par tampon
  DIM mrow$(3),pj$(7),pj.pt&(7) ! libelles du menu, huit joueurs et leurs points
  RESTORE sin.vague
  FOR i&=0 TO 15
    READ sinus&(i&)
  NEXT i&
  txt.vague&=0 ! 0 = texte droit, 1 = texte ondule
  RESTORE rc.niveaux
  FOR i&=0 TO 12
    READ rcniv&(i&)
  NEXT i&
  @pixinit
  pix.duree&=6000 ! duree de la revelation en trames : 6000 / 50 Hz = 120 s
  fin.no&=0 ! transition de fin en cours, cf. @fin.rapide
  '
  ' ////////////////////////////////
  a|=BYTE{&HFF820D}
  BYTE{&HFF820D}=15
  b|=BYTE{&HFF820D}
  BYTE{&HFF820D}=a|
  IF a|<>b|  ! If Ste or Falcon (not STf not TT)
    blitter(TRUE)
  ENDIF
  BMOVE &HFFFF8240,savpal%,32
  key|=BYTE{&H484}                  ! save keyboard
  inter|=BYTE{&HFFFA09}             ! save interrupts
  BYTE{&H484}=BYTE{&H484} AND &HFE  ! keyboad sound off
  CLIP 0,0,320,200      ! required for patched libs otherwise gfx are not visible
  ON ERROR GOSUB bye    ! hope this doesn't slow program
  ON BREAK GOSUB bye    ! to avoid disagreements in case...    !<
  @vdicol
RETURN
.
' !>
PROCEDURE screen.opening(pic%)
  ' Les deux tampons sont vides explicitement. CLS ne touche que l'ecran de
  ' dessin courant, donc l'ancien CLS / stab / CLS effacait deux fois le meme :
  ' le stab basculait sur le tampon encore rempli par le BLOAD de la fonte
  ' 16x22, et le sheet restait a l'ecran pendant toute l'ouverture.
  RC_COPY log%,0,0,320,200 TO log%,0,0,0
  RC_COPY phy%,0,0,320,200 TO phy%,0,0,0
  stab
  ' Meme desynchronisation ici, et la palette est deja active : les ellipses
  ' alternaient entre deux tampons de contenus differents. Un seul ecran suffit.
  @dboff
  ~XBIOS(6,L:pal%)
  COLOR 15
  DEFFILL 15
  FOR x|=1 TO 159 STEP 4
    VSYNC
    PELLIPSE 159,99,x|,2
  NEXT x|
  CLS
  stab
  CLS
  '
  @dboff
  y2|=99
  FOR y|=100 TO 199
    VSYNC
    BMOVE pic%+t160&(y|),phy%+t160&(y|),160
    BMOVE pic%+t160&(y2|),phy%+t160&(y2|),160
    LINE 0,y2|-2,319,y2|-2
    LINE 19,y2|-3,300,y2|-3
    LINE 149,y2|-4,169,y2|-4
    LINE 0,y|+2,319,y|+2
    LINE 19,y|+3,300,y|+3
    LINE 149,y|+4,169,y|+4
    DEC y2|
  NEXT y|
  BMOVE pic%,log%,32000
  BMOVE pic%,phy%,32000                                        !<
RETURN
.
' !>
PROCEDURE intro_quizz
  ' Les textes fixes sont remplaces par le scrolltext 16x22 du bas d'ecran.
  ' Plus aucun registre force ici : la fonte 16x22 est peinte dans la palette
  ' de l'image d'intro, on n'y touche pas.
  @scroll2.init
  @note3d.init
  @menu.init
RETURN
.
' !>
PROCEDURE quizz
  ' WIP
  ' Etapes avec passage controle clavier  (SPACE SKIP & NEXT TUNE - BACKSPACE>PREVIOUS TUNE):
  ' 1) juste la musique sans image
  ' 2) l'image tres brouillee  (v Transition brouillee / net  progressive dont le timing est a definir)
  ' 3) l'image non brouillee
  ' 4) l'image avec le texte dessus  (centre : TITRE  ->  CR  -> description)
  ' 5) Modif fonte 8x8 en 1 plan avec outline
  '
  ' from quizz title quizz
  ' $FFFC02 garde le dernier code recu : on n'agit que sur les CHANGEMENTS,
  ' sinon une touche maintenue defilerait le menu a 50 crans par seconde.
  ' Un appui produit deux changements, le code d'enfoncement puis celui de
  ' relachement (bit 7 a 1), et seul le premier est transmis.
  ' Espace ne sort plus directement : en sous-menu il ramene au menu, et
  ' @menu.touche leve menu.go! seulement depuis le menu principal.
  REPEAT
    matouche&=BYTE{&HFFFC02}
    IF matouche&<>menu.pk&
      menu.pk&=matouche&
      IF matouche&<128
        @menu.touche(matouche&)
      ENDIF
    ENDIF
    @vumetre
    @scroll2.step
    @note3d.step
    @menu.step
    stab
  UNTIL menu.go!
  @wait.release
  @page.regles
  FOR file&=0 TO nb_files_max&-1
    BMOVE log%,phy%,32000 ! copy log to phy
    ' WAIT for ENTER or BACKSPACE
    ' ~XBIOS(5,L:log%,L:phy%,-1) ! on repasse en double bufffer pour scanner log pendant vision phy
    @ldpic(pic_fname$(file&),pic%,FALSE) ! load picture matching with current music
    @set_text_colors ! pick ink/box colours from this track picture palette
    ' BMOVE pic%,log%,32000 !
    ' scan_pic_for_color(TRUE)
    ' ~XBIOS(5,L:phy%,L:phy%,-1)  ! on arrete le double ecran
    @fadeoff
    ' BMOVE pic%,phy%,32000
    @clearpal
    @sndh.off
    BLOAD sndh_fname$(file&),tune%
    RC_COPY log%,0,0,320,200 TO log%,0,0,0 ! clear screens
    RC_COPY phy%,0,0,320,200 TO phy%,0,0,0
    @sndh(tune%) ! musique seule...
    ' Affichage progressif par etapes
    @dboff ! screen double buffer off (basic fx)
    ' @ldpic(pic_fname$(file&),pic%,FALSE) ! load picture matching with current music
    @fadeon ! color fading up
    ' progressive animation / fx from very pixelated picture, to perfect pixel
    ' Effets de revelation, enchaines et reordonnables ici. @scrambling etait
    ' auparavant appele DEPUIS pixelisation ; le sortir permet d'alterner les
    ' effets d'un morceau a l'autre sans toucher aux procedures.
    ' Alternance des effets de revelation, un par morceau. Les quatre effets
    ' partagent l'interface (duree&) en trames et finissent en dissolve si
    ' l'espace est presse.
    SELECT MOD(file&,4)
    CASE 0
      @pixelisation(pix.duree&)
    CASE 1
      @scrambling(pix.duree&)
    CASE 2
      @dezoom.rc(600) ! budget d'attente modeste : cet effet est lent par nature
    CASE 3
      @random_pixels(pix.duree&)
    ENDSELECT
    @fadereg0 ! monte la couleur de fond une fois l'image dessinee (cf. fadeon)
    ' @scrambling
    ' display answer bitmap text on 2 lines : 1 : Artist Name  2 : Music Name
    @dboff ! screen double buffer off (basic fx)
    @answer_display(answer1$(file&),answer2$(file&))
    ' L'attente statique est remplacee par l'ondulation animee : elle tourne
    ' jusqu'a ENTREE ou BACKSPACE et laisse matouche& renseigne.
    @txt.anim(answer1$(file&),answer2$(file&))
    IF matouche&=&HE ! SI BACKSPACE ! back to previous track
      DEC file&
      DEC file& ! decreasing twice as we need to go before the previous track as it will be increased on NEXT
      IF file&<-1 ! if we were already on the first track
        file&=-1
      ENDIF
    ENDIF
  NEXT file& ! next music to guess
  @sndh.off
  BLOAD "DATA\ATRISTST.SND",tune%
  @ldpic("DATA\FIREWORK.PI1",pic%,FALSE)
  @set_text_colors ! pick ink/box colours from the fireworks picture palette
  @fadeoff
  @clearpal
  RC_COPY log%,0,0,320,200 TO log%,0,0,0 ! clear screens
  RC_COPY phy%,0,0,320,200 TO phy%,0,0,0
  @sndh(tune%)
  ' Ecran de credits fixe, remplace par @finale. Conserve en commentaire au
  ' cas ou une autre image ou d'autres textes y reviendraient.
  ' @screen.opening(pic%)
  ' display.bitmap.txt("C EST FINI !",80,30,TRUE,TRUE,FALSE)
  ' display.bitmap.txt("MERCI POUR VOTRE PARTICIPATION !",20,50,TRUE,TRUE,FALSE)
  ' display.bitmap.txt("ET BRAVO",20,65,TRUE,TRUE,FALSE)
  ' display.bitmap.txt("POUR LES REPONSES TROUVEES !",60,75,TRUE,TRUE,FALSE)
  @finale
RETURN
.
' !>
PROCEDURE scroll2.init
  ' Scrolltext de l'ecran d'intro, fonte 16x22 sur 2 plans (4 couleurs).
  ' Grille de 20 cellules par rangee, 3 rangees, 44 glyphes en tout : le sheet
  ' s'arrete au 9, le zero est fabrique depuis le O par @base_files_load.
  ' L'ordre ci-dessous a ete releve glyphe par glyphe sur 2P_16_22.PI1 ; les
  ' cases 30 et 31 sont bien une parenthese ouvrante et une fermante, elles se
  ' lisent comme un O quand elles se suivent.
  f2.chars$="ABCDEFGHIJKLMNOPQRST"
  f2.chars$=f2.chars$+"UVWXYZ-!?,()'.:12345"
  f2.chars$=f2.chars$+"67890"
  s2$="      ADN QUIZZ 2026   -   30 MORCEAUX, 30 IMAGES, "
  s2$=s2$+"ET VOS OREILLES POUR SEULE ARME   -   "
  s2$=s2$+"L IMAGE SE DEVOILE PENDANT QUE LA MUSIQUE TOURNE... "
  s2$=s2$+"A VOUS DE TROUVER AVANT LA FIN !   -   "
  s2$=s2$+"ESPACE POUR ABREGER, ESPACE POUR LA REPONSE, "
  s2$=s2$+"ESPACE POUR LA SUITE. ESPACE, QUOI.   -   "
  s2$=s2$+"BONNE CHANCE !      "
  ' La bande de reference vit hors ecran, dans lowborderm% qui fait justement
  ' 22 lignes. Elle est recopiee telle quelle dans le tampon de dessin a chaque
  ' trame, donc les deux ecrans de stab montrent la meme chose. Decaler log%
  ' directement, comme avant, revenait a donner une colonne sur deux a chaque
  ' tampon : d'ou le clignotement et la vitesse divisee par deux.
  ' MALLOC ne rend pas de memoire vide, il faut effacer.
  s2.band%=lowborderm%
  RC_COPY s2.band%,0,0,320,22 TO s2.band%,0,0,0
  s2.pas&=2 ! colonnes par trame, 1 a 4 au choix
  s2.car&=0
  s2.col&=0
  @scroll2.char
RETURN
.
' !>
PROCEDURE scroll2.char
  ' Coin haut gauche du glyphe courant dans le sheet. s2.sx&=-1 pour un
  ' caractere absent de la fonte, l'espace surtout : la colonne reste vide.
  LOCAL pc&
  pc&=PRED(INSTR(f2.chars$,MID$(s2$,SUCC(s2.car&),1)))
  IF pc&<0
    s2.sx&=-1
  ELSE
    s2.sy&=0
    WHILE pc&>=20
      SUB pc&,20
      ADD s2.sy&,22
    WEND
    s2.sx&=SHL&(pc&,4)
  ENDIF
RETURN
.
' !>
PROCEDURE scroll2.step
  ' Une trame : la bande de reference glisse de s2.pas& pixels, les colonnes
  ' entrantes sont remplies une a une, puis les 22 lignes partent d'un bloc
  ' dans le tampon de dessin. Les lignes 178 a 199 y sont contigues, soit un
  ' seul BMOVE de 3520 octets a partir de 178*160.
  ' Pas de 17 pixels par caractere : 16 de glyphe plus 1 de separation, la
  ' fonte n'ayant aucune colonne vide a droite. 17 n'etant multiple de rien,
  ' les colonnes entrantes sont traitees une par une plutot qu'en tranche.
  LOCAL k&,dx&
  dx&=320-s2.pas&
  RC_COPY s2.band%,s2.pas&,0,dx&,22 TO s2.band%,0,0
  RC_COPY s2.band%,dx&,0,s2.pas&,22 TO s2.band%,dx&,0,0
  FOR k&=0 TO PRED(s2.pas&)
    IF s2.sx&>=0 AND s2.col&<16
      RC_COPY fnt2%,ADD(s2.sx&,s2.col&),s2.sy&,1,22 TO s2.band%,ADD(dx&,k&),0
    ENDIF
    INC s2.col&
    IF s2.col&>=17
      s2.col&=0
      INC s2.car&
      IF s2.car&>=LEN(s2$)
        s2.car&=0
      ENDIF
      @scroll2.char
    ENDIF
  NEXT k&
  BMOVE s2.band%,log%+28480,3520
RETURN
.
' !>
PROCEDURE note3d.init
  ' Croche en fil de fer pour l'ecran d'intro. 13 sommets stockes, 21 dessines :
  ' la tete est un octogone trace deux fois, decale de +/- n3.ep& en Z, la tige
  ' et le crochet restent dans le plan Z=0. Quatre aretes relient les deux
  ' octogones, un sommet sur deux, ce qui suffit a donner le volume.
  ' Table sinus 256 pas en virgule fixe 7 bits : n3sin&() va de -127 a +127,
  ' le cosinus est le meme tableau decale d'un quart de tour.
  ' 256 pas et non 64 : avec 64 pas les axes X et Z n'avancaient que d'un cran
  ' toutes les 2 et 4 trames, ils restaient immobiles entre deux - d'ou une
  ' saccade reguliere a 25 et 12 Hz. Ici chaque axe bouge a chaque trame.
  LOCAL i&,j&
  DIM n3hx&(7),n3hy&(7),n3tx&(4),n3ty&(4)
  DIM n3px&(20),n3py&(20),n3ax&(8),n3ay&(8)
  DIM n3rx&(7,20),n3ry&(7,20)
  DIM n3sin&(255)
  FOR i&=0 TO 255
    n3sin&(i&)=ROUND(127*SIN(6.2831853*i&/256))
  NEXT i&
  RESTORE note3d.modele
  FOR i&=0 TO 7
    READ n3hx&(i&),n3hy&(i&)
  NEXT i&
  FOR i&=0 TO 4
    READ n3tx&(i&),n3ty&(i&)
  NEXT i&
  n3.cx&=40
  n3.cy&=40
  n3.ep&=6 ! demi-epaisseur de la tete
  ' Trois angles sur 256 pas. Y avance de 4, X de 2, Z de 1 : un tour en 1,3 s,
  ' 2,6 s et 5,1 s. Les trois periodes ne retombent jamais ensemble sur une
  ' trame, la croche ne repasse donc pas par la meme pose.
  n3.fx&=0
  n3.fy&=0
  n3.fz&=0
  ' Trainee : n3.tr& poses precedentes redessinees derriere la croche, prises
  ' toutes les 2 trames dans l'anneau n3rx&/n3ry&. Rien n'est recalcule, ce sont
  ' des points deja projetes ; seul le trace coute. L'estompage prend deux
  ' registres de la rampe de la fonte 16x22 : le 9 puis le 5, de luminosites
  ' 6,9 et 3,1 la ou l'encre de la croche est a 13,1. Rien n'est force dans la
  ' palette, ce sont des couleurs de l'image.
  ' Mettre 0 si la trame ne tient plus, 3 si elle tient large.
  n3.tr&=2
  n3.rp&=0
  FOR i&=0 TO 7
    FOR j&=0 TO 20
      n3rx&(i&,j&)=n3.cx&
      n3ry&(i&,j&)=n3.cy&
    NEXT j&
  NEXT i&
  ' Boite restauree a chaque trame, calee sur 16 pixels. Sur toutes les
  ' orientations le dessin s'ecarte du centre de -40 a +38 dans les deux sens,
  ' soit x et y de 0 a 78 : la boite prend le coin haut gauche, x 0-79 sur
  ' 40 octets et 79 lignes. 40,40 est le centre le plus proche de l'origine
  ' sans rognage - descendre a 36 ferait mordre 4 pixels sur le bord gauche
  ' dans les poses extremes (le CLIP les couperait proprement, mais quand meme).
  ' La boite evite le VU-metre (x 272-303, y 94-109) et le scrolltext (y>=178).
  n3.ob&=0
  n3.lg&=40
  n3.y1&=0
  n3.y2&=78
note3d.modele:
' Croche, +y vers le BAS. D'abord la tete, octogone de rayons 14 x 10 incline
' de 20 degres, puis la tige et le crochet dans l'ordre du trace.
DATA 3,19,2,27,-7,33,-17,34
DATA -23,29,-22,21,-13,15,-3,14
DATA 4,20,4,-36,12,-30,18,-20,16,-8
RETURN
.
' !>
PROCEDURE note3d.step
  ' Une trame. La boite est d'abord remise a l'image d'intro depuis pic%, qui
  ' la contient encore intacte, puis les 13 sommets sont tournes sur les trois
  ' axes et projetes : Xv=xv*d/(zv+d) (real-time-3d-gfx-atari-st p.79), d=256.
  ' Tout est reconstruit a chaque trame, donc les deux tampons de stab
  ' recoivent une image complete - pas de dessin incremental ici.
  ' La matrice Rz.Ry.Rx est calculee une fois par trame en virgule fixe 7 bits,
  ' puis chaque sommet ne coute que 6 produits au lieu de 12.
  ' Les deux faces de la tete ne different que par Z : on ne transforme que le
  ' plan median et on ajoute +/- ep& fois la 3e colonne de la matrice. Huit
  ' transformations economisees.
  ' Division par 128 : SHR et non DIV, mais sur une valeur rendue positive par
  ' un biais de 65536 retire ensuite. La reference GFA dit de SHR& que le bit 15
  ' est recopie vers les bits 16 a 31 "preservant ainsi le signe", ce qui laisse
  ' entendre un decalage arithmetique sans le dire ; le biais rend la question
  ' sans objet et coute deux additions contre une division.
  LOCAL i&,g&,r&,x&,y&,vx&,vy&,vz&,dn&,s%,d%
  LOCAL rsx&,rcx&,rsy&,rcy&,rsz&,rcz&,sysx&,sycx&
  LOCAL m11&,m12&,m13&,m21&,m22&,m23&,m31&,m32&,m33&,ex&,ey&,ez&
  s%=ADD(pic%,ADD(t160&(n3.y1&),n3.ob&))
  d%=ADD(log%,ADD(t160&(n3.y1&),n3.ob&))
  FOR i&=n3.y1& TO n3.y2&
    BMOVE s%,d%,n3.lg&
    ADD s%,160
    ADD d%,160
  NEXT i&
  rsx&=n3sin&(n3.fx&)
  rcx&=n3sin&(AND(ADD(n3.fx&,64),255))
  rsy&=n3sin&(n3.fy&)
  rcy&=n3sin&(AND(ADD(n3.fy&,64),255))
  rsz&=n3sin&(n3.fz&)
  rcz&=n3sin&(AND(ADD(n3.fz&,64),255))
  sysx&=SUB(SHR(ADD(MUL(rsy&,rsx&),65536),7),512)
  sycx&=SUB(SHR(ADD(MUL(rsy&,rcx&),65536),7),512)
  m11&=SUB(SHR(ADD(MUL(rcz&,rcy&),65536),7),512)
  m12&=SUB(SHR(ADD(SUB(MUL(rcz&,sysx&),MUL(rsz&,rcx&)),65536),7),512)
  m13&=SUB(SHR(ADD(ADD(MUL(rcz&,sycx&),MUL(rsz&,rsx&)),65536),7),512)
  m21&=SUB(SHR(ADD(MUL(rsz&,rcy&),65536),7),512)
  m22&=SUB(SHR(ADD(ADD(MUL(rsz&,sysx&),MUL(rcz&,rcx&)),65536),7),512)
  m23&=SUB(SHR(ADD(SUB(MUL(rsz&,sycx&),MUL(rcz&,rsx&)),65536),7),512)
  m31&=-rsy&
  m32&=SUB(SHR(ADD(MUL(rcy&,rsx&),65536),7),512)
  m33&=SUB(SHR(ADD(MUL(rcy&,rcx&),65536),7),512)
  ' Decalage d'extrusion : ep& fois la 3e colonne de la matrice.
  ex&=DIV(MUL(m13&,n3.ep&),128)
  ey&=DIV(MUL(m23&,n3.ep&),128)
  ez&=DIV(MUL(m33&,n3.ep&),128)
  FOR i&=0 TO 7
    x&=n3hx&(i&)
    y&=n3hy&(i&)
    vx&=SUB(SHR(ADD(ADD(MUL(m11&,x&),MUL(m12&,y&)),65536),7),512)
    vy&=SUB(SHR(ADD(ADD(MUL(m21&,x&),MUL(m22&,y&)),65536),7),512)
    vz&=SUB(SHR(ADD(ADD(MUL(m31&,x&),MUL(m32&,y&)),65536),7),512)
    dn&=ADD(SUB(vz&,ez&),256) ! jamais nul : |vz&| plafonne a 44
    n3px&(i&)=ADD(n3.cx&,DIV(SHL(SUB(vx&,ex&),8),dn&))
    n3py&(i&)=ADD(n3.cy&,DIV(SHL(SUB(vy&,ey&),8),dn&))
    dn&=ADD(ADD(vz&,ez&),256)
    n3px&(ADD(i&,8))=ADD(n3.cx&,DIV(SHL(ADD(vx&,ex&),8),dn&))
    n3py&(ADD(i&,8))=ADD(n3.cy&,DIV(SHL(ADD(vy&,ey&),8),dn&))
  NEXT i&
  FOR i&=0 TO 4
    x&=n3tx&(i&)
    y&=n3ty&(i&)
    vx&=SUB(SHR(ADD(ADD(MUL(m11&,x&),MUL(m12&,y&)),65536),7),512)
    vy&=SUB(SHR(ADD(ADD(MUL(m21&,x&),MUL(m22&,y&)),65536),7),512)
    vz&=SUB(SHR(ADD(ADD(MUL(m31&,x&),MUL(m32&,y&)),65536),7),512)
    dn&=ADD(vz&,256)
    n3px&(ADD(i&,16))=ADD(n3.cx&,DIV(SHL(vx&,8),dn&))
    n3py&(ADD(i&,16))=ADD(n3.cy&,DIV(SHL(vy&,8),dn&))
  NEXT i&
  ' Pose du jour rangee dans l'anneau, puis trainee : les poses d'il y a 2 et
  ' 4 trames, redessinees telles quelles. Sans les aretes de liaison, elles
  ' n'ajoutent rien de lisible a cette taille.
  FOR i&=0 TO 20
    n3rx&(n3.rp&,i&)=n3px&(i&)
    n3ry&(n3.rp&,i&)=n3py&(i&)
  NEXT i&
  IF n3.tr&>0
    FOR g&=1 TO n3.tr&
      r&=AND(ADD(n3.rp&,SUB(8,SHL&(g&,1))),7) ! +8-2g plutot que -2g, on reste positif
      IF g&=1
        COLOR vdicol|(9) ! le clair de la rampe de la fonte 16x22
      ELSE
        COLOR vdicol|(5) ! le sombre
      ENDIF
      FOR i&=0 TO 7
        n3ax&(i&)=n3rx&(r&,i&)
        n3ay&(i&)=n3ry&(r&,i&)
      NEXT i&
      n3ax&(8)=n3rx&(r&,0)
      n3ay&(8)=n3ry&(r&,0)
      POLYLINE 9,n3ax&(),n3ay&()
      FOR i&=0 TO 7
        n3ax&(i&)=n3rx&(r&,ADD(i&,8))
        n3ay&(i&)=n3ry&(r&,ADD(i&,8))
      NEXT i&
      n3ax&(8)=n3rx&(r&,8)
      n3ay&(8)=n3ry&(r&,8)
      POLYLINE 9,n3ax&(),n3ay&()
      FOR i&=0 TO 4
        n3ax&(i&)=n3rx&(r&,ADD(i&,16))
        n3ay&(i&)=n3ry&(r&,ADD(i&,16))
      NEXT i&
      POLYLINE 5,n3ax&(),n3ay&()
    NEXT g&
  ENDIF
  n3.rp&=AND(SUCC(n3.rp&),7)
  COLOR vdicol|(ink_col&)
  ' Trois POLYLINE plutot que dix-huit LINE : un seul appel VDI par contour.
  FOR i&=0 TO 7
    n3ax&(i&)=n3px&(i&)
    n3ay&(i&)=n3py&(i&)
  NEXT i&
  n3ax&(8)=n3px&(0)
  n3ay&(8)=n3py&(0)
  POLYLINE 9,n3ax&(),n3ay&()
  FOR i&=0 TO 7
    n3ax&(i&)=n3px&(ADD(i&,8))
    n3ay&(i&)=n3py&(ADD(i&,8))
  NEXT i&
  n3ax&(8)=n3px&(8)
  n3ay&(8)=n3py&(8)
  POLYLINE 9,n3ax&(),n3ay&()
  FOR i&=0 TO 4
    n3ax&(i&)=n3px&(ADD(i&,16))
    n3ay&(i&)=n3py&(ADD(i&,16))
  NEXT i&
  POLYLINE 5,n3ax&(),n3ay&()
  ' Un sommet sur deux relie les deux faces : suffit a donner le volume.
  FOR i&=0 TO 6 STEP 2
    LINE n3px&(i&),n3py&(i&),n3px&(ADD(i&,8)),n3py&(ADD(i&,8))
  NEXT i&
  n3.fx&=AND(ADD(n3.fx&,2),255)
  n3.fy&=AND(ADD(n3.fy&,4),255)
  n3.fz&=AND(SUCC(n3.fz&),255)
RETURN
.
' !>
PROCEDURE menu.init
  ' Menu du cadre en bas a gauche de l'image d'intro. L'interieur noir uni du
  ' cadre va de x 3 a 66 et de y 125 a 167, mesure sur ADNQUIZZ.PI1.
  ' Curseur : carre de 4 pixels en x 4-7. Libelles : 7 caracteres de la fonte
  ' 8x8 a partir de x 10, soit jusqu'a x 65. Quatre lignes, y 128 a 158.
  ' Le cadre etant noir uni, un PBOX en couleur 0 l'efface exactement : pas
  ' besoin d'aller rechercher le fond dans pic%.
  LOCAL i&
  chif$="0123456789"
  ' Table clavier du TOS : donne l'ASCII d'un code de touche sans supposer la
  ' disposition du clavier (XBIOS 16, cf. gfaxpert). Sert a la saisie des noms.
  keytbl%=LPEEK(XBIOS(16,L:-1,L:-1,L:-1))
  menu.mode&=0 ! 0 menu, 1 jukebox ; le reste passe par des pages plein ecran
  menu.sel&=0
  menu.go!=FALSE
  jb.no&=0
  sai$=""
  FOR i&=0 TO 7
    pj$(i&)=""
    pj.pt&(i&)=0
  NEXT i&
  ' Etat clavier de depart : sans cela un code deja present serait pris pour
  ' un appui des la premiere trame.
  menu.pk&=BYTE{&HFFFC02}
  pt.pk&=menu.pk& ! meme precaution pour les touches de fonction du quizz
  @menu.rows
  menu.rf&=2
  menu.rc&=0
RETURN
.
' !>
PROCEDURE menu.d2(n&)
  ' Deux chiffres dans d2$, pour 0 a 99. STR$ n'est pas utilise : selon les
  ' versions il ajoute une espace en tete des nombres positifs.
  d2$=MID$(chif$,SUCC(DIV(n&,10)),1)+MID$(chif$,SUCC(MOD(n&,10)),1)
RETURN
.
' !>
PROCEDURE menu.rows
  ' Remplit les quatre libelles selon le mode. Sept caracteres au plus,
  ' c'est la largeur utile du cadre.
  LOCAL i&
  SELECT menu.mode&
  CASE 0
    mrow$(0)="JOUEURS"
    mrow$(1)="SCORES"
    mrow$(2)="REGLES"
    mrow$(3)="JUKEBOX"
  CASE 1
    @menu.d2(SUCC(jb.no&))
    mrow$(0)="JUKEBOX"
    mrow$(1)="NO "+d2$
    mrow$(2)=""
    mrow$(3)="RETOUR"
  ENDSELECT
RETURN
.
' !>
PROCEDURE menu.draw
  ' Repeint tout le cadre dans le tampon de dessin courant.
  ' Effacement en RC_COPY mode 0 plutot qu'en PBOX : le mode 0 ecrit des
  ' zeros sans rien lire ni dependre d'un etat, alors que PBOX suit DEFFILL,
  ' qu'il faut donc poser puis remettre pour le reste du programme.
  LOCAL i&
  RC_COPY log%,3,125,64,43 TO log%,3,125,0
  FOR i&=0 TO 3
    @menu.text(mrow$(i&),10,ADD(128,MUL(i&,10)),log%)
  NEXT i&
  @menu.curseur
RETURN
.
' !>
PROCEDURE menu.curseur
  ' Le curseur seul : on efface sa colonne, on repose le carre. Aucun libelle
  ' ne commence avant x 10, la colonne 4-8 leur est etrangere.
  LOCAL y&
  RC_COPY log%,4,125,5,43 TO log%,4,125,0
  y&=ADD(128,MUL(menu.sel&,10))
  DEFFILL vdicol|(ink_col&)
  PBOX 4,ADD(y&,2),7,ADD(y&,5)
RETURN
.
' !>
PROCEDURE menu.text(t$,xb&,yb&,adr%)
  ' Une ligne de fonte 8x8 a l'etat final du rideau, sans stab : le menu est
  ' redessine dans la boucle d'intro, il ne peut pas basculer les tampons.
  ' La garde sur la longueur n'est pas decorative : le FOR de GFA teste en
  ' bas de boucle, donc FOR i&=1 TO 0 passe une fois. Sur une chaine vide on
  ' irait chercher MID$(t$,1,1) et on poserait un glyphe parasite - les modes
  ' jukebox et scores ont justement des lignes vides.
  LOCAL i&,pc&,cx&
  IF LEN(t$)>0
    cx&=xb&
    FOR i&=1 TO LEN(t$)
      pc&=PRED(INSTR(font.chars$,MID$(t$,i&,1)))
      IF pc&>=0 AND pc&<PRED(len.font&)
        RC_COPY fmask%,56,0,8,8 TO adr%,cx&,yb&
        RC_COPY font%,bitmap.char.x&(pc&),bitmap.char.y&(pc&),8,8 TO adr%,cx&,yb&,1
      ENDIF
      ADD cx&,8
    NEXT i&
  ENDIF
RETURN
.
' !>
PROCEDURE menu.step
  ' Une trame. La plupart du temps il n'y a rien a faire : le cadre ne bouge
  ' pas et vit deja dans les deux tampons. Apres un changement on redessine
  ' deux trames de suite, une par tampon de stab.
  IF menu.rf&>0
    @menu.draw
    DEC menu.rf&
  ELSE
    IF menu.rc&>0
      @menu.curseur
      DEC menu.rc&
    ENDIF
  ENDIF
RETURN
.
' !>
PROCEDURE menu.touche(code&)
  ' Un appel par appui : l'appelant ne transmet que les changements de code,
  ' et seulement les enfoncements (le relachement a le bit 7 a 1).
  ' Codes releves dans gfaxpert : haut $48, bas $50, entree $1C, backspace
  ' $0E, echap $01, espace $39.
  IF code&=&H39
    IF menu.mode&=0
      menu.go!=TRUE
    ELSE
      @menu.mode(0)
    ENDIF
  ELSE
    SELECT menu.mode&
    CASE 0
      @menu.deplacer(code&)
      IF code&=&H1C
        @menu.entrer
      ENDIF
    CASE 1
      IF code&=&H48 AND jb.no&>0
        DEC jb.no&
        @menu.jouer
      ENDIF
      IF code&=&H50 AND jb.no&<PRED(nb_files_max&)
        INC jb.no&
        @menu.jouer
      ENDIF
      IF code&=&H1C OR code&=&H01
        @menu.mode(0)
      ENDIF
    ENDSELECT
  ENDIF
RETURN
.
' !>
PROCEDURE menu.deplacer(code&)
  ' Haut et bas, avec bouclage. Les deux calculs restent positifs.
  IF code&=&H48
    menu.sel&=AND(ADD(menu.sel&,3),3)
    menu.rc&=2
  ENDIF
  IF code&=&H50
    menu.sel&=AND(SUCC(menu.sel&),3)
    menu.rc&=2
  ENDIF
RETURN
.
' !>
PROCEDURE menu.mode(m&)
  ' Change de mode et demande un repeint complet du cadre.
  menu.mode&=m&
  IF m&=0
    menu.sel&=0
  ENDIF
  @menu.rows
  menu.rf&=2
RETURN
.
' !>
PROCEDURE menu.entrer
  ' Validation depuis le menu principal.
  SELECT menu.sel&
  CASE 0
    @page.joueurs
  CASE 1
    @page.scores
  CASE 2
    @page.regles
  CASE 3
    @menu.mode(1)
    @menu.jouer
  ENDSELECT
RETURN
.
' !>
PROCEDURE menu.jouer
  ' Charge et lance le morceau choisi. tune% est le tampon de la musique
  ' d'intro : elle est perdue, mais @quizz recharge un morceau a chaque tour,
  ' donc rien a remettre en place au demarrage du quizz.
  @sndh.off
  BLOAD sndh_fname$(jb.no&),tune%
  @sndh(tune%)
  @menu.rows
  menu.rf&=2
RETURN
.
' !>
PROCEDURE page.ouvrir
  ' Prepare une page plein ecran. Un seul tampon : ces pages sont fixes, le
  ' double tampon n'y sert a rien et obligerait a tout dessiner deux fois.
  ' On dessine donc directement dans phy%, qui est l'ecran affiche.
  @dboff
  RC_COPY phy%,0,0,320,200 TO phy%,0,0,0
RETURN
.
' !>
PROCEDURE page.fermer
  ' Remet l'image d'intro dans les deux tampons. Le premier stab de la boucle
  ' remettra le double tampon en service tout seul.
  BMOVE pic%,log%,32000
  BMOVE pic%,phy%,32000
  menu.pk&=BYTE{&HFFFC02}
  menu.rf&=2 ! le cadre du menu vient d'etre efface, il faut le reposer
RETURN
.
' !>
PROCEDURE page.ligne(t$,y&,centre!)
  ' Une ligne de page. 38 caracteres au plus, c'est ce qui tient en 320.
  LOCAL x&
  IF centre!
    x&=160-SHL&(LEN(t$),2) ! 8 pixels par caractere, donc 4 par demi
  ELSE
    x&=8
  ENDIF
  @menu.text(t$,x&,y&,phy%)
RETURN
.
' !>
PROCEDURE page.regles
  ' Regles, controles et credits sur un seul ecran. Affichee au demarrage
  ' entre l'accueil et le premier morceau, et rappelable par le menu.
  ' Tout tient d'un coup et y reste : cette page est faite pour etre lue a
  ' voix haute a ceux qui sont trop loin de l'ecran. Le scrolltext ne peut
  ' pas jouer ce role, il se merite et se rate.
  ' Une ligne = une phrase courte, 38 caracteres au plus.
  @page.ouvrir
  @page.ligne("ADN QUIZZ 2026",4,TRUE)
  @page.ligne("REGLES",22,TRUE)
  @page.ligne("LE PREMIER QUI DONNE LE TITRE",36,TRUE)
  @page.ligne("DU MORCEAU MARQUE LE POINT",46,TRUE)
  @page.ligne("L IMAGE EST UN INDICE, PAS LA REPONSE",56,TRUE)
  @page.ligne("ARTISTE ET TITRE S AFFICHENT ENSUITE",66,TRUE)
  @page.ligne("CONTROLES",84,TRUE)
  @page.ligne("ESPACE : DEMARRER, ABREGER, SUITE",98,TRUE)
  @page.ligne("BACKSPACE : MORCEAU PRECEDENT",108,TRUE)
  @page.ligne("FLECHES ET ENTREE : MENU D ACCUEIL",118,TRUE)
  @page.ligne("F1 A F8 : POINT AU JOUEUR 1 A 8",128,TRUE)
  @page.ligne("CREDITS",146,TRUE)
  @page.ligne("CODE ET FONTES : HYLST",160,TRUE)
  @page.ligne("MUSIQUES YM2149 : AD ET DMA SC",170,TRUE)
  @page.ligne("INTRO : JESS",180,TRUE)
  @page.ligne("ESPACE POUR CONTINUER",192,TRUE)
  @wait_key(&H39)
  @page.fermer
RETURN
.
' !>
PROCEDURE point(i&)
  ' Un point au joueur i& (0 a 7), depuis F1 a F8 pendant la revelation.
  ' Si l'emplacement est libre on demande d'abord le nom : c'est le cas du
  ' joueur qui trouve avant de s'etre inscrit.
  ' Tout se passe dans les 16 dernieres lignes de l'ecran, sauvees puis
  ' remises. Pas de page plein ecran ici : elle effacerait la revelation en
  ' cours, et @page.fermer remettrait pic% - donc l'image entiere, soit la
  ' reponse offerte.
  ' Les effets de revelation tournent apres @dboff, phy% est donc a la fois
  ' l'ecran affiche et celui qu'ils dessinent.
  LOCAL ok!
  BMOVE phy%+29440,bandsav%,2560 ! lignes 184 a 199
  ok!=TRUE
  IF pj$(i&)=""
    @point.nom(i&)
    ok!=(pj$(i&)<>"")
  ENDIF
  IF ok!
    IF pj.pt&(i&)<99
      INC pj.pt&(i&)
    ENDIF
    @menu.d2(pj.pt&(i&))
    @point.bande(pj$(i&)+" : "+d2$)
    @point.tenir(75) ! une seconde et demie
  ENDIF
  BMOVE bandsav%,phy%+29440,2560
  pt.pk&=BYTE{&HFFFFC02}
RETURN
.
' !>
PROCEDURE point.bande(t$)
  ' Efface la bande du bas et y ecrit une ligne centree.
  RC_COPY phy%,0,184,320,16 TO phy%,0,184,0
  @menu.text(t$,160-SHL&(LEN(t$),2),188,phy%)
RETURN
.
' !>
PROCEDURE point.tenir(n&)
  ' Attente simple. La musique tourne sous interruption, elle continue.
  LOCAL k&
  FOR k&=1 TO n&
    VSYNC
  NEXT k&
RETURN
.
' !>
PROCEDURE point.nom(i&)
  ' Saisie d'un nom sans quitter la revelation : uniquement dans la bande du
  ' bas, que @point a sauvegardee. Entree valide, ESC renonce au point.
  LOCAL k&,pk&,fini!,p$
  sai$=""
  fini!=FALSE
  p$="JOUEUR "+MID$(chif$,ADD(i&,2),1)+" : "
  @point.bande(p$+"-")
  pk&=BYTE{&HFFFFC02}
  REPEAT
    VSYNC
    k&=BYTE{&HFFFFC02}
    IF k&<>pk&
      pk&=k&
      IF k&<128
        SELECT k&
        CASE &H1C
          pj$(i&)=sai$
          fini!=TRUE
        CASE &H01
          fini!=TRUE
        CASE &HE
          IF LEN(sai$)>0
            sai$=LEFT$(sai$,PRED(LEN(sai$)))
            @point.bande(p$+sai$+"-")
          ENDIF
        DEFAULT
          @saisie.lettre(k&)
          @point.bande(p$+sai$+"-")
        ENDSELECT
      ENDIF
    ENDIF
  UNTIL fini!
RETURN
.
' !>
PROCEDURE page.joueurs
  ' Huit joueurs, huit lettres par nom. Le cadre de l'ecran d'accueil n'en
  ' montrait que quatre de quatre lettres : c'etait sa largeur qui limitait,
  ' pas la machine. Une page plein ecran leve les deux contraintes.
  LOCAL s&,k&,pk&,fini!
  s&=0
  fini!=FALSE
  @page.ouvrir
  @page.pjliste(s&)
  pk&=BYTE{&HFFFC02}
  REPEAT
    VSYNC
    k&=BYTE{&HFFFC02}
    IF k&<>pk&
      pk&=k&
      IF k&<128
        SELECT k&
        CASE &H48
          s&=AND(ADD(s&,7),7)
          @page.pjliste(s&)
        CASE &H50
          s&=AND(SUCC(s&),7)
          @page.pjliste(s&)
        CASE &H1C
          @page.saisie(s&)
          @page.pjliste(s&)
          pk&=BYTE{&HFFFC02}
        CASE &H39
          fini!=TRUE
        CASE &H01
          fini!=TRUE
        ENDSELECT
      ENDIF
    ENDIF
  UNTIL fini!
  @page.fermer
RETURN
.
' !>
PROCEDURE page.pjliste(s&)
  ' Les huit emplacements, curseur sur celui qui est choisi.
  LOCAL i&,y&
  RC_COPY phy%,0,0,320,200 TO phy%,0,0,0
  @page.ligne("JOUEURS",16,TRUE)
  FOR i&=0 TO 7
    y&=ADD(48,MUL(i&,14))
    @menu.d2(SUCC(i&))
    IF pj$(i&)=""
      @page.ligne(d2$+"  -",y&,FALSE)
    ELSE
      @page.ligne(d2$+"  "+pj$(i&),y&,FALSE)
    ENDIF
  NEXT i&
  DEFFILL vdicol|(ink_col&)
  y&=ADD(50,MUL(s&,14))
  PBOX 0,y&,4,ADD(y&,4)
  @page.ligne("FLECHES : CHOISIR",172,TRUE)
  @page.ligne("ENTREE : NOMMER   ESPACE : REVENIR",184,TRUE)
RETURN
.
' !>
PROCEDURE page.saisie(s&)
  ' Saisie d'un nom. La table clavier du TOS (XBIOS 16) donne l'ASCII de la
  ' touche sans supposer la disposition du clavier. Lettres seules : la
  ' fonte 8x8 n'a pas de minuscules, et sur un clavier francais les chiffres
  ' demandent Shift, donc une deuxieme table.
  LOCAL k&,pk&,fini!
  sai$=pj$(s&)
  fini!=FALSE
  @page.nom
  pk&=BYTE{&HFFFC02}
  REPEAT
    VSYNC
    k&=BYTE{&HFFFC02}
    IF k&<>pk&
      pk&=k&
      IF k&<128
        SELECT k&
        CASE &H1C
          pj$(s&)=sai$
          fini!=TRUE
        CASE &H01
          fini!=TRUE
        CASE &HE
          IF LEN(sai$)>0
            sai$=LEFT$(sai$,PRED(LEN(sai$)))
            @page.nom
          ENDIF
        DEFAULT
          @saisie.lettre(k&)
          @page.nom
        ENDSELECT
      ENDIF
    ENDIF
  UNTIL fini!
RETURN
.
' !>
PROCEDURE saisie.lettre(code&)
  ' Ajoute une lettre a sai$ si la touche en est une. Le redessin est a la
  ' charge de l'appelant : la saisie se fait tantot en plein ecran, tantot
  ' dans une bande de 16 lignes pendant la revelation.
  LOCAL a&
  IF keytbl%>0 AND LEN(sai$)<8
    a&=BYTE{keytbl%+code&}
    IF a&>=97 AND a&<=122
      SUB a&,32
    ENDIF
    IF a&>=65 AND a&<=90
      sai$=sai$+CHR$(a&)
    ENDIF
  ENDIF
RETURN
.
' !>
PROCEDURE page.nom
  ' L'ecran de saisie, redessine a chaque frappe. Le tiret tient lieu de
  ' curseur : la fonte n'a pas de bloc plein.
  RC_COPY phy%,0,0,320,200 TO phy%,0,0,0
  @page.ligne("NOM DU JOUEUR",16,TRUE)
  @page.ligne(sai$+"-",92,TRUE)
  @page.ligne("LETTRES SEULEMENT, HUIT AU PLUS",160,TRUE)
  @page.ligne("ENTREE VALIDE   ESC ANNULE",184,TRUE)
RETURN
.
' !>
PROCEDURE page.scores
  ' Points de la session. Les noms sont completes a huit caracteres pour que
  ' la colonne des points reste alignee.
  LOCAL i&,n&,y&,p$
  @page.ouvrir
  @page.ligne("SCORES",16,TRUE)
  n&=0
  FOR i&=0 TO 7
    IF pj$(i&)<>""
      y&=ADD(48,MUL(i&,14))
      p$=pj$(i&)+"        "
      @menu.d2(pj.pt&(i&))
      @page.ligne(LEFT$(p$,8)+"   "+d2$,y&,FALSE)
      INC n&
    ENDIF
  NEXT i&
  IF n&=0
    @page.ligne("AUCUN JOUEUR ENREGISTRE",92,TRUE)
  ENDIF
  @page.ligne("ESPACE POUR REVENIR",188,TRUE)
  @wait_key(&H39)
  @page.fermer
RETURN
.
' !>
PROCEDURE vumetre
  ' Trois barres de 4 pixels, 1 d'ecart : 280-283, 285-288, 290-293, base a
  ' y=109. Posees au fond de l'ecran du moniteur de l'image d'intro, dont
  ' l'interieur noir mesure x 262-309 et y 74-112. Zone restauree x 272-303,
  ' calee sur 16, deux groupes soit 16 octets par ligne a partir du 136e.
  ' Dessin dans log% puis stab : a y=4 le faisceau arrivait trop vite, ce n'est
  ' plus un souci a cette hauteur mais le principe reste le meme.
  ' XBIOS(28,0,reg) = Giaccess. 8 = voie A, 9 = B, 10 = C, bits 3-0 = niveau.
  ' Bit 4 a 1 = volume pilote par l'enveloppe, on affiche le maximum.
  LOCAL v&,c&,h&,yl&,bx&
  FOR yl&=94 TO 109
    BMOVE pic%+t160&(yl&)+136,log%+t160&(yl&)+136,16
  NEXT yl&
  COLOR vdicol|(ink_col&)
  DEFFILL vdicol|(ink_col&)
  bx&=280
  FOR c&=0 TO 2
    v&=XBIOS(28,0,ADD(8,c&))
    IF (v& AND 16)
      h&=15
    ELSE
      h&=v& AND 15
    ENDIF
    IF h&>0
      PBOX bx&,110-h&,bx&+3,109
    ENDIF
    ADD bx&,5 ! avance par addition plutot que MUL(c&,5)
  NEXT c&
RETURN
.
' !>
PROCEDURE finale
  ' Ecran de fin : feu d'artifice en boucle, credits en scrolltext sur les 8
  ' dernieres lignes. Espace sort et rend la main a bye, qui restaure le GEM.
  ' La fonte 8x8 sait desormais faire - ' ( ), d'ou les apostrophes et les
  ' parentheses. Pas d'accents en revanche, et majuscules seulement.
  scroll$="      C'EST FINI !   BRAVO A CEUX QUI ONT TROUVE, "
  scroll$=scroll$+"ET COURAGE AUX AUTRES.   -   "
  scroll$=scroll$+"CE QUE VOUS VENEZ D'ENTENDRE N'EST PAS UN ENREGISTREMENT : "
  scroll$=scroll$+"CHAQUE GENERIQUE A ETE REPRIS NOTE A NOTE ET REECRIT "
  scroll$=scroll$+"POUR LE SOUNDCHIP YM2149 DE NOS BONS VIEUX ATARI ST, "
  scroll$=scroll$+"PAR AD ET DMA SC.   "
  scroll$=scroll$+"TROIS VOIES, UN GENERATEUR DE BRUIT (ET BEAUCOUP DE PATIENCE).   -   "
  scroll$=scroll$+"CODE ET FONTES : HYLST, AVEC UN COUP DE MAIN DE TOMCHI.   "
  scroll$=scroll$+"MUSIQUE D'INTRO : JESS.   -   "
  scroll$=scroll$+"GREETINGS A JBFOU ET DIANE, QUI FONT TOURNER L'ADN PARTY "
  scroll$=scroll$+"A TANTONVILLE, ET A TOUS LES JOYEUX ATARISTES BOUT-EN-TRAIN "
  scroll$=scroll$+"QUI ONT REPONDU PRESENT.   -   "
  scroll$=scroll$+"ESPACE POUR RENDRE LA MAIN AU BUREAU.      "
  ' Palette propre au feu d'artifice. @clearpal a mis tous les registres a
  ' zero et le seul XBIOS(6) qui les restaurait etait dans screen.opening,
  ' desormais commente : sans cette rampe tout serait dessine noir sur noir.
  ' Rampe de braise, du rouge sombre au blanc, noir en 0.
  SETCOLOR 0,0,0,0
  FOR i&=1 TO 15
    fr&=i&
    IF fr&>7
      fr&=7
    ENDIF
    fv&=i&-6
    IF fv&<0
      fv&=0
    ENDIF
    IF fv&>7
      fv&=7
    ENDIF
    fb&=i&-11
    IF fb&<0
      fb&=0
    ENDIF
    IF fb&>7
      fb&=7
    ENDIF
    SETCOLOR i&,fr&,fv&,fb&
  NEXT i&
  ' Forcer l'encre du scroll au blanc chaud de la rampe. set_text_colors a
  ' choisi ink_col& d'apres la palette de FIREWORK.PI1, qui n'a plus cours
  ' ici : sans cela la lisibilite du texte dependrait de cette image.
  ink_col&=15
  recolor_font(15)
  scroll.car&=0
  scroll.col&=0
  FOR i&=0 TO 63
    fvie&(i&)=0
    epx&(0,i&)=-1
    epx&(1,i&)=-1
  NEXT i&
  fx.par&=0
  fx.delai&=0
  ' nettoyer les DEUX tampons une fois pour toutes : l'effacement cible ne
  ' repasse ensuite que sur les points dessines
  RC_COPY log%,0,0,320,200 TO log%,0,0,0
  stab
  RC_COPY log%,0,0,320,200 TO log%,0,0,0
  REPEAT
    @fx.step
    @scroll.step
    stab ! stab fait deja son VSYNC : une trame par tour au lieu de deux
    matouche&=BYTE{&HFFFC02}
  UNTIL matouche&=&H39
  @wait.release
RETURN
.
' !>
PROCEDURE fx.step
  ' Une gerbe de 16 particules toutes les 10 trames, sur 4 emplacements
  ' tournants : jusqu'a 4 gerbes simultanees a des stades differents.
  ' Position en seiziemes de pixel, fvie& sert de compteur et d'index de
  ' couleur. Effacement cible par generation : stab alterne les tampons, celui
  ' qu'on dessine l'a ete il y a deux trames.
  LOCAL i&,px&,py&,ang&,c&,ad%,mk&,nm&
  fx.par&=1-fx.par&
  FOR i&=0 TO 63
    IF epx&(fx.par&,i&)>=0
      ' cpset recopie ici : c'etait 128 appels de procedure par trame. En
      ' couleur 0 les quatre plans tombent, donc un simple ET sur chacun.
      ad%=log%+t160&(epy&(fx.par&,i&))+SHL&(SHR&(epx&(fx.par&,i&),4),3)
      nm&=NOT SHL&(1,15-AND(epx&(fx.par&,i&),15))
      CARD{ad%}=CARD{ad%} AND nm&
      CARD{ad%+2}=CARD{ad%+2} AND nm&
      CARD{ad%+4}=CARD{ad%+4} AND nm&
      CARD{ad%+6}=CARD{ad%+6} AND nm&
      epx&(fx.par&,i&)=-1
    ENDIF
  NEXT i&
  DEC fx.delai&
  IF fx.delai&<1
    ' Une gerbe toutes les 10 trames sur quatre emplacements tournants : le
    ' tableau de 64 particules porte donc jusqu'a quatre gerbes simultanees, a
    ' des stades differents. L'ecran est mieux couvert et la charge devient
    ' reguliere, chaque pic d'initialisation etant identique. Un emplacement
    ' est reutilise toutes les 40 trames, au-dela de la vie maximale de 39.
    fx.delai&=10
    fx.cx&=SHL&(ADD(40,RANDOM(240)),4) ! x16 par decalage
    fx.cy&=SHL&(ADD(40,RANDOM(90)),4)
    ' 16 particules par gerbe au lieu de 32 : l'initialisation, avec ses
    ' RANDOM, tenait sur une seule trame et produisait un a-coup periodique.
    FOR i&=fx.slot& TO fx.slot&+15
      ang&=i&-fx.slot& ! rang dans la gerbe : les 16 crans de la table
      fx&(i&)=fx.cx&
      fy&(i&)=fx.cy&
      fvx&(i&)=MUL(sinus&(AND(ang&,15)),ADD(6,RANDOM(6)))
      fvy&(i&)=MUL(sinus&(AND(ADD(ang&,4),15)),ADD(6,RANDOM(6)))
      fvie&(i&)=ADD(24,RANDOM(16))
    NEXT i&
    ADD fx.slot&,16
    IF fx.slot&>48
      fx.slot&=0
    ENDIF
  ENDIF
  FOR i&=0 TO 63
    IF fvie&(i&)>0
      ADD fx&(i&),fvx&(i&)
      ADD fy&(i&),fvy&(i&)
      ADD fvy&(i&),3 ! gravite
      DEC fvie&(i&)
      px&=SHR&(fx&(i&),4)
      py&=SHR&(fy&(i&),4)
      IF py&>0 AND py&<190 AND px&>0 AND px&<319
        c&=SHR&(fvie&(i&),1) ! fvie& monte a 39, donc c& a 19 : a borner
        IF c&>15
          c&=15
        ENDIF
        ' Dessin par OU seul, la position venant d'etre liberee. Deux
        ' particules qui se croisent melangent leurs bits et donnent un point
        ' plus clair : pour un feu d'artifice c'est plutot heureux.
        ad%=log%+t160&(py&)+SHL&(SHR&(px&,4),3)
        mk&=SHL&(1,15-AND(px&,15))
        IF (c& AND 1)
          CARD{ad%}=CARD{ad%} OR mk&
        ENDIF
        IF (c& AND 2)
          CARD{ad%+2}=CARD{ad%+2} OR mk&
        ENDIF
        IF (c& AND 4)
          CARD{ad%+4}=CARD{ad%+4} OR mk&
        ENDIF
        IF (c& AND 8)
          CARD{ad%+6}=CARD{ad%+6} OR mk&
        ENDIF
        epx&(fx.par&,i&)=px&
        epy&(fx.par&,i&)=py&
      ELSE
        fvie&(i&)=0
      ENDIF
    ENDIF
  NEXT i&
RETURN
.
' !>
PROCEDURE scroll.step
  ' Scrolltext sur les 8 dernieres lignes. La bande est poussee de 2 pixels a
  ' gauche, puis la tranche suivante du caractere courant entre par la droite.
  ' Applique aux DEUX tampons : un decalage depend de l'etat precedent de son
  ' tampon, il n'est pas reconstructible comme un redessin complet.
  LOCAL pc&
  ' decaler les deux tampons
  RC_COPY log%,2,192,318,8 TO log%,0,192
  RC_COPY phy%,2,192,318,8 TO phy%,0,192
  ' Effacer la colonne entrante AVANT d'y dessiner. Sans cela l'espace, qui
  ' porte l'indice 43 et n'est donc pas dessine, laissait passer l'ancien
  ' contenu du bord droit : c'est la trainee observee. display.bitmap.txt n'a
  ' pas ce probleme, son masque REPLACE effacant la cellule au prealable.
  RC_COPY log%,318,192,2,8 TO log%,318,192,0
  RC_COPY phy%,318,192,2,8 TO phy%,318,192,0
  ' tranche suivante du caractere courant
  pc&=PRED(INSTR(font.chars$,MID$(scroll$,SUCC(scroll.car&),1)))
  IF pc&>=0 AND pc&<PRED(len.font&) ! dernier indice = espace, deja efface ci-dessus
    RC_COPY font%,ADD(bitmap.char.x&(pc&),scroll.col&),bitmap.char.y&(pc&),2,8 TO log%,318,192
    RC_COPY font%,ADD(bitmap.char.x&(pc&),scroll.col&),bitmap.char.y&(pc&),2,8 TO phy%,318,192
  ENDIF
  ADD scroll.col&,2
  IF scroll.col&>=8
    scroll.col&=0
    INC scroll.car&
    IF scroll.car&>=LEN(scroll$)
      scroll.car&=0
    ENDIF
  ENDIF
RETURN
.
' !>
PROCEDURE bye
  ' Couper la musique EN PREMIER : le lecteur SNDH tourne sous interruption
  ' dans le bloc MALLOC. Si on quitte sans l'arreter, GEMDOS libere ce bloc,
  ' le realloue a autre chose, et l'interruption continue d'y sauter.
  @sndh.off
  @dboff
  ' Restaurer l'ecran et la resolution d'origine. Sans cela l'ecran reste
  ' pointe sur un tampon du bloc MALLOC, que GEMDOS vient de liberer : le
  ' bureau GEM affiche alors de la memoire recyclee.
  ~XBIOS(5,L:oldlog%,L:oldphy%,oldrez&)
  ~XBIOS(6,L:savpal%) ! restore pal
  BYTE{&H484}=key|    ! restore keyboard
  BYTE{&HFFFA09}=inter|  !  restore interrupts
  ~GEMDOS(32,L:sup%) ! user mode on
  ' L'ALERT de debug qui s'affichait ici partait aussi en sortie normale,
  ' bye etant le chemin volontaire autant que le gestionnaire d'erreur.
  ' ~GRAF_MOUSE(257,0) ! =OUT 4,8 show mouse (showm don't work with patched libs)
  OUT 4,8
  IF NOT compiled!
    RESERVE
  ENDIF
  EDIT                                             !<
RETURN
.
.*************************************************************************************************
.
.
' !>
PROCEDURE display.bitmap.txt(text$,xb&,yb&,horizontal!,bg_erase!,center!)
  ' DISPLAY TEXT AT X, Y COORDINATES (UP-LEFT) WITH BITMAP FONT
  ' ! no clipping ! one line only (no carriage return) bombs if text >39 chars
  ' lost machine time should be use for precalc or have to put under interrupt
  ' centrage
  len.text&=PRED(LEN(text$))
  IF len.text&>38
    text$=LEFT$(text$,38)  ! tronquage...
    len.text&=PRED(LEN(text$)) ! max 40 chars
  ENDIF
  IF center!
    xb&=160-(len.text&+1)*char.width&/2
  ENDIF
  ' La bande effacee est plus haute de l'amplitude de l'ondulation (3 pixels
  ' de part et d'autre), sinon les lettres hautes laissent une trainee.
  IF bg_erase!
    IF txt.vague&=0
      area.lines.erase(xb&-2,yb&-2,xb&+(1+len.text&)*char.width&+2,yb&+char.height&)
    ELSE
      area.lines.erase(xb&-2,yb&-5,xb&+(1+len.text&)*char.width&+2,yb&+char.height&+3)
    ENDIF
  ENDIF
  ' Boucles INVERSEES : l'etat du rideau est desormais la boucle externe, et
  ' tous les caracteres sont dessines a chaque etat. Auparavant chaque lettre
  ' faisait ses 8 etats avec un stab a chacun, soit 8 trames par lettre : une
  ' ligne de 30 caracteres coutait 240 trames, presque 5 secondes. Le rideau
  ' est maintenant global : 8 trames pour la ligne entiere.
  ' Pour revenir a l'apparition lettre par lettre, il suffit de remettre la
  ' boucle char& a l'exterieur et le stab a l'interieur.
  cx&=0
  FOR m.appear&=0 TO 7*8 STEP 8
    cx&=xb&
    cy&=yb&
    FOR char&=1 TO SUCC(len.text&)
      pos.char&=PRED(INSTR(font.chars$,MID$(text$,char&,1)))
      ' Ondulation : chaque lettre est posee sur une sinusoide, decalee d'un
      ' ecran par caractere. La vague est STATIQUE - la position de repos est
      ' deja ondulee - donc aucune lettre ne se deplace entre deux etats du
      ' rideau, et il n'y a pas de trainee a effacer.
      IF txt.vague&=0
        yv&=yb&
      ELSE
        yv&=yb&+sinus&(AND(char&,15))
      ENDIF
      IF pos.char&>=0 AND pos.char&<PRED(len.font&) ! -1 = hors police, dernier = espace
        IF horizontal!
          RC_COPY fmask%,m.appear&,0,8,8 TO log%,cx&,yv&
          RC_COPY font%,bitmap.char.x&(pos.char&),bitmap.char.y&(pos.char&),char.width&,char.height& TO log%,cx&,yv&,1
        ELSE
          RC_COPY fmask%,m.appear&,0,8,8 TO log%,xb&,cy&
          RC_COPY font%,bitmap.char.x&(pos.char&),bitmap.char.y&(pos.char&),char.width&,char.height& TO log%,xb&,cy&,1
        ENDIF
      ENDIF
      ' avance par addition plutot que MUL(PRED(char&),char.width&)
      ADD cx&,char.width&
      ADD cy&,char.width&
    NEXT char&
    stab
  NEXT m.appear&
sin.vague:
  DATA 0,1,2,3,3,3,2,1,0,-1,-2,-3,-3,-3,-2,-1                                               !<
RETURN
.
' !>
PROCEDURE ldpic(fname$,adr%,spk!)
  IF spk!
    BLOAD fname$,adr% ! for speedpacker decrunch
    ' spk ! speed packer decrunching
    BMOVE adr%+2,pal%,32
    BMOVE adr%+34,adr%,32000
  ELSE
    OPEN "I",#1,fname$
    SEEK #1,2                  ! skip resolution
    BGET #1,pal%,32            ! load palette of picture
    SEEK #1,34
    BGET #1,adr%,32000         ! load actual picture
    CLOSE #1
  ENDIF                        !<
RETURN
.
' !>
PROCEDURE dysplay_text_shuffle(background%,text%)
  FOR i&=0 TO 199
    lignes&(i&)=i&
  NEXT i&
  ' Melange de Fisher-Yates
  FOR i&=199 TO 1 STEP -1
    j&=RANDOM(i&)
    SWAP lignes&(i&),lignes&(j&)
  NEXT i&
  ' Copier l'image de fond dans les deux buffers une fois
  RC_COPY background%,0,0,320,200 TO log%,0,0,7
  RC_COPY background%,0,0,320,200 TO phy%,0,0,7
  ' --- Boucle d'affichage progressif
  i&=0
  WHILE i&<200
    y&=lignes&(i&)
    ' Ajouter la ligne courante
    RC_COPY text%,0,y&,320,1 TO log%,0,y&,7
    IF i&>0
      yprev&=lignes&(i&-1)
      RC_COPY text%,0,yprev&,320,1 TO log%,0,yprev&,7
    ENDIF
    ' Affichage synchro
    VSYNC
    ~XBIOS(5,L:log%,L:phy%,-1)
    SWAP log%,phy%
    INC i&
  WEND
RETURN
'
PROCEDURE wait.release
  ' Attend le RELACHEMENT de la touche. Les codes de relachement ont le bit 7
  ' a 1 ($B9 pour espace, contre $39 a l'enfoncement).
  '
  ' Indispensable depuis que tout se pilote a l'espace : sans cela, maintenir
  ' la touche enchainerait l'abandon de l'effet, l'affichage de la reponse et
  ' le passage au morceau suivant en une fraction de seconde, on n'aurait le
  ' temps de rien voir.
  LOCAL k&
  REPEAT
    VSYNC
    k&=BYTE{&HFFFFC02}
  UNTIL k&>=128
RETURN
.
' !>
PROCEDURE tatouche
  ' $FFFFFC02 conserve le DERNIER code recu, et le garde jusqu'au suivant.
  ' Accepter aussi le code de relachement ($B9) etait une mauvaise idee : ce
  ' code reste dans le registre apres l'appui sur l'ecran d'intro, et le
  ' 1er effet de revelation le relisait aussitot, donc s'abregeait seul.
  ' On ne teste plus que l'enfoncement. Comme $39 reste present tant que la
  ' touche est maintenue, un appui normal est capte sans avoir a insister,
  ' a condition de sonder assez souvent, cf. dezoom.rc.
  tatouche&=BYTE{&HFFFFC02}
  IF tatouche&=&H39
    pixl_exit&=1
  ENDIF
  ' Attribution d'un point pendant la revelation : F1 a F8 pour les huit
  ' emplacements de joueur. gfaxpert donne F1=$3B et F10=$44, soit dix
  ' touches pour dix codes consecutifs, donc F1 a F8 vont de $3B a $42.
  ' Les chiffres auraient ete plus naturels mais leurs codes ne sont pas
  ' dans le corpus, et sur un clavier francais ils demandent Shift.
  ' Front montant seulement : $FFFC02 garde le dernier code, une touche
  ' maintenue distribuerait un point a chaque appel.
  IF tatouche&<>pt.pk&
    pt.pk&=tatouche&
    IF tatouche&>=&H3B AND tatouche&<=&H42
      @point(SUB(tatouche&,&H3B))
    ENDIF
  ENDIF
RETURN
'
PROCEDURE pixinit
  LOCAL o&
  RESTORE pix.niveaux
  FOR o&=0 TO 8
    READ pnh&(o&),pnv&(o&)
  NEXT o&
pix.niveaux:
  DATA 16,16,16,8,8,8,8,4,4,4,4,2,2,2,2,1,1,1
RETURN
.
' !>
PROCEDURE pixdraw(nh&,nv&)
  ' Construit dans log% la version de pic% pixelisee en blocs nh& x nv&.
  ' Horizontal : masque plus decalages, en LONG, 40 iterations par ligne. Les
  ' masques gardent des bits assez loin de la frontiere de mot pour que
  ' l'etalement ne deborde pas sur le plan voisin.
  ' Vertical : replication par doublement, 4 BMOVE pour 16 lignes.
  LOCAL yy&,i&,nl&,c&,d&,sl%,dl%,w%
  IF nh&=1 AND nv&=1
    BMOVE pic%,log%,32000
  ELSE
    dl%=log%
    FOR yy&=0 TO 199 STEP nv&
      sl%=pic%+t160&(yy&)
      ' Transformation en LONG : 2 mots a la fois, 40 iterations par ligne
      ' au lieu de 80. Deux mots consecutifs sont deux PLANS differents du
      ' meme groupe de 16 pixels - un decalage pourrait donc faire fuir un bit
      ' d'un plan vers l'autre. Ce n'est pas le cas : les masques ne gardent
      ' que des bits assez eloignes de la frontiere pour que l'etalement reste
      ' dans son mot. Verifie sur 30000 longs aleatoires, aucune divergence.
      ' adresses ecran sont paires, l'acces LONG est donc legal.
      IF nh&=16
        FOR i&=0 TO 156 STEP 4
          w%=LONG{sl%+i&} AND &H80008000
          w%=w% OR SHR(w%,1)
          w%=w% OR SHR(w%,2)
          w%=w% OR SHR(w%,4)
          LONG{dl%+i&}=w% OR SHR(w%,8)
        NEXT i&
      ELSE IF nh&=8
        FOR i&=0 TO 156 STEP 4
          w%=LONG{sl%+i&} AND &H80808080
          w%=w% OR SHR(w%,1)
          w%=w% OR SHR(w%,2)
          LONG{dl%+i&}=w% OR SHR(w%,4)
        NEXT i&
      ELSE IF nh&=4
        FOR i&=0 TO 156 STEP 4
          w%=LONG{sl%+i&} AND &H88888888
          w%=w% OR SHR(w%,1)
          LONG{dl%+i&}=w% OR SHR(w%,2)
        NEXT i&
      ELSE IF nh&=2
        FOR i&=0 TO 156 STEP 4
          w%=LONG{sl%+i&} AND &HAAAAAAAA
          LONG{dl%+i&}=w% OR SHR(w%,1)
        NEXT i&
      ELSE
        BMOVE sl%,dl%,160 ! nh&=1 : la ligne source telle quelle
      ENDIF
      ' replication verticale par doublement, bornee a la fin de l'ecran
      nl&=nv&
      IF yy&+nl&>200
        nl&=200-yy&
      ENDIF
      c&=1
      WHILE c&<nl&
        d&=c&
        IF c&+d&>nl&
          d&=nl&-c&
        ENDIF
        BMOVE dl%,dl%+MUL(c&,160),MUL(d&,160)
        ADD c&,d&
      WEND
      ADD dl%,MUL(nv&,160)
    NEXT yy&
  ENDIF
RETURN
.
' !>
PROCEDURE pixelisation(duree&)
  ' 9 niveaux x 20 bandes = 180 etapes, une modification toutes les 0,67 s
  ' pour pix.duree&=6000 trames.
  ' Le niveau est construit hors ecran dans log% puis devoile bande par bande
  ' vers phy%. Aucun stab ici : un echange ferait disparaitre les bandes deja
  ' devoilees. Le sens de balayage alterne d'un niveau a l'autre.
  LOCAL niv&,bande&,b2&,tenue&,off%
  pixl_exit&=0
  tenue&=DIV(duree&,180) ! 9 niveaux x 20 bandes
  FOR niv&=0 TO 8
    @pixdraw(pnh&(niv&),pnv&(niv&))
    FOR bande&=0 TO 19
      IF EVEN(niv&)
        b2&=bande&
      ELSE
        b2&=19-bande&
      ENDIF
      @pixhold(tenue&)
      EXIT IF pixl_exit&=1
      off%=MUL(b2&,1600) ! 10 lignes de 160 octets
      BMOVE log%+off%,phy%+off%,1600
    NEXT bande&
    EXIT IF pixl_exit&=1
  NEXT niv&
  ' espace : on n'affiche pas l'image d'un coup, on la revele en dissolve
  IF pixl_exit&=1
    @fin.rapide(100) ! 100 trames = 2 s
  ELSE
    BMOVE pic%,phy%,32000
    BMOVE pic%,log%,32000
  ENDIF
RETURN
.
' !>
PROCEDURE dezoom.rc(duree&)
  ' Dezoom par RC_COPY : recopie un bloc SOURCE de 4x4 et le pave, d'ou une
  ' deformation differente du dezoom net de @pixdraw.
  ' Lent par nature. duree& est un budget d'attente reparti par rangee, le
  ' temps de dessin s'y ajoute. 13 paliers multiples de 4 : en dessous de 4 la
  ' copie serait exacte et plus rien ne bougerait.
  LOCAL cycle&,taille&,x&,y&,i&,j&,bh&,bl&,tr&
  tr&=DIV(duree&,160) ! 13 paliers totalisant 160 rangees
  IF tr&<1
    tr&=1
  ENDIF
  pixl_exit&=0
  FOR cycle&=0 TO 12
    taille&=rcniv&(cycle&)
    FOR y&=0 TO 199 STEP taille&
      bh&=taille&
      IF y&+bh&>200
        bh&=200-y&
      ENDIF
      FOR x&=0 TO 319 STEP taille&
        bl&=taille&
        IF x&+bl&>320
          bl&=320-x&
        ENDIF
        FOR j&=0 TO PRED(bh&) STEP 4
          FOR i&=0 TO PRED(bl&) STEP 4
            RC_COPY pic%,x&,y&,4,4 TO phy%,x&+i&,y&+j&
          NEXT i&
        NEXT j&
        ' sondage clavier pendant le balayage : une rangee grossiere prend
        ' plusieurs dixiemes de seconde, l'appui y serait sinon ignore
        @tatouche
        EXIT IF pixl_exit&=1
      NEXT x&
      EXIT IF pixl_exit&=1
      ' attente courte apres CHAQUE rangee
      @pixhold(tr&)
      EXIT IF pixl_exit&=1
    NEXT y&
    EXIT IF pixl_exit&=1
  NEXT cycle&
  IF pixl_exit&=1
    @fin.rapide(100)
  ELSE
    BMOVE pic%,phy%,32000
    BMOVE pic%,log%,32000
  ENDIF
rc.niveaux:
  DATA 72,64,56,48,40,32,28,24,20,16,12,8,4
RETURN
.
' !>
PROCEDURE fin.rapide(trames&)
  ' Transition de fin, appelee quand un effet lent est abrege. L'image nette
  ' ne doit jamais surgir d'un coup, mais on ne fait plus attendre : deux
  ' secondes environ. Quatre transitions en alternance.
  ' Compteur separe de MOD(file&,4) qui choisit l'effet lent : un morceau
  ' devine tout de suite et un morceau ecoute jusqu'au bout ne consomment pas
  ' le meme nombre de tours, les deux suites se decalent d'elles-memes.
  ' Aucune n'est interruptible : on est deja dans le chemin d'abandon, et
  ' pixl_exit& vaut 1, donc @pixhold rendrait la main aussitot. VSYNC direct.
  SELECT AND(fin.no&,3)
  CASE 0
    @dissolve.to.pic(trames&)
  CASE 1
    @volet.store(trames&)
  CASE 2
    @volet.biais(trames&)
  CASE 3
    @volet.centre(trames&)
  ENDSELECT
  fin.no&=AND(SUCC(fin.no&),3)
RETURN
.
' !>
PROCEDURE volet.store(trames&)
  ' Store venitien : une ligne sur 16, puis sur 8, sur 4, sur 2, puis toutes.
  ' L'image se densifie au lieu d'apparaitre par morceaux. Les lignes deja
  ' posees sont recopiees a la passe suivante, ca ne coute qu'un BMOVE de plus
  ' et ca evite de tenir une liste.
  LOCAL s&,i&,t&,k&
  t&=DIV(trames&,5)
  IF t&<1
    t&=1
  ENDIF
  s&=16
  WHILE s&>=1
    FOR i&=0 TO 199 STEP s&
      BMOVE pic%+t160&(i&),phy%+t160&(i&),160
    NEXT i&
    FOR k&=1 TO t&
      VSYNC
    NEXT k&
    s&=SHR&(s&,1)
  WEND
  BMOVE pic%,phy%,32000
  BMOVE pic%,log%,32000
RETURN
.
' !>
PROCEDURE volet.biais(trames&)
  ' Front diagonal : la droite x+y=t& balaie l'ecran du coin haut gauche au
  ' coin bas droit, ce qui donne une lumiere rasante. lignes&() retient pour
  ' chaque ligne le dernier groupe de 16 pixels recopie, on ne transporte donc
  ' que la nouveaute - environ 60 BMOVE de 8 octets par trame.
  ' 520 = 319+199 arrondi, la course complete du front.
  LOCAL i&,t&,pas&,g&,gt&,d&
  FOR i&=0 TO 199
    lignes&(i&)=-1
  NEXT i&
  pas&=DIV(520,trames&)
  IF pas&<1
    pas&=1
  ENDIF
  t&=0
  WHILE t&<520
    VSYNC
    FOR i&=0 TO 199
      d&=SUB(t&,i&)
      IF d&>=0 ! SHR& sur un positif, le front n'a pas encore atteint la ligne
        gt&=SHR&(d&,4)
        IF gt&>19
          gt&=19
        ENDIF
        g&=lignes&(i&)
        WHILE g&<gt&
          INC g&
          BMOVE pic%+t160&(i&)+SHL&(g&,3),phy%+t160&(i&)+SHL&(g&,3),8
        WEND
        lignes&(i&)=gt&
      ENDIF
    NEXT i&
    ADD t&,pas&
  WEND
  BMOVE pic%,phy%,32000
  BMOVE pic%,log%,32000
RETURN
.
' !>
PROCEDURE volet.centre(trames&)
  ' Deux volets partent du milieu et s'ecartent vers le haut et vers le bas.
  ' Deux BMOVE de ligne par cran : la moins chere des quatre.
  LOCAL h&,n&,pas&,k&
  pas&=DIV(100,trames&)
  IF pas&<1
    pas&=1
  ENDIF
  h&=0
  WHILE h&<100
    VSYNC
    FOR k&=1 TO pas&
      IF h&<100
        n&=SUB(99,h&)
        BMOVE pic%+t160&(n&),phy%+t160&(n&),160
        n&=ADD(100,h&)
        BMOVE pic%+t160&(n&),phy%+t160&(n&),160
        INC h&
      ENDIF
    NEXT k&
  WEND
  BMOVE pic%,phy%,32000
  BMOVE pic%,log%,32000
RETURN
.
' !>
PROCEDURE dissolve.to.pic(trames&)
  ' Devoile pic% ligne par ligne en ordre aleatoire, en trames& trames.
  ' La premiere des quatre transitions de @fin.rapide, et la seule appelable
  ' seule si un effet a besoin de cette fin precise.
  LOCAL i&,r&,temp&,k&,parlot&,n&
  FOR i&=0 TO 199
    lignes&(i&)=i&
  NEXT i&
  ' ordre de devoilement aleatoire
  FOR i&=199 TO 1 STEP -1
    r&=RANDOM(i&)
    temp&=lignes&(i&)
    lignes&(i&)=lignes&(r&)
    lignes&(r&)=temp&
  NEXT i&
  parlot&=DIV(200,trames&) ! lignes devoilees par trame
  IF parlot&<1
    parlot&=1
  ENDIF
  n&=0
  WHILE n&<200
    VSYNC
    FOR k&=1 TO parlot&
      IF n&<200
        i&=lignes&(n&)
        BMOVE pic%+t160&(i&),phy%+t160&(i&),160
        INC n&
      ENDIF
    NEXT k&
  WEND
  BMOVE pic%,phy%,32000
  BMOVE pic%,log%,32000
RETURN
.
' !>
PROCEDURE pixhold(trames&)
  ' Attente interruptible : rend la main des que l'espace est presse.
  LOCAL k&
  FOR k&=1 TO trames&
    VSYNC
    @tatouche
    EXIT IF pixl_exit&=1
  NEXT k&
RETURN
.
' !>
PROCEDURE txt.ligne(t$,yb&,freq&,dph&)
  ' Dessine UNE ligne de texte a l'etat final du rideau (masque 56), chaque
  ' lettre posee sur la sinusoide decalee par txt.phase&. Sert a l'animation :
  ' pas de rideau, et dessin dans log%, le tampon HORS ECRAN.
  ' freq& : nombre de crans de la table par caractere : 1 donne une vague
  '   longue, 2 une vague deux fois plus serree.
  ' dph& : decalage de phase, pour desynchroniser deux lignes.
  LOCAL nc&,c&,px&,pc&,yv&,ac&
  nc&=PRED(LEN(t$))
  IF nc&>38
    t$=LEFT$(t$,38)
    nc&=PRED(LEN(t$))
  ENDIF
  px&=160-(nc&+1)*char.width&/2
  ac&=freq& ! avance par addition plutot que MUL(c&,freq&)
  FOR c&=1 TO SUCC(nc&)
    pc&=PRED(INSTR(font.chars$,MID$(t$,c&,1)))
    IF pc&>=0 AND pc&<PRED(len.font&) ! -1 = hors police, dernier = espace
      yv&=yb&+sinus&(AND(ADD(ac&,ADD(txt.phase&,dph&)),15))
      RC_COPY fmask%,56,0,8,8 TO log%,px&,yv&
      RC_COPY font%,bitmap.char.x&(pc&),bitmap.char.y&(pc&),char.width&,char.height& TO log%,px&,yv&,1
    ENDIF
    ADD px&,char.width&
    ADD ac&,freq&
  NEXT c&
RETURN
.
' !>
PROCEDURE txt.anim(a1$,a2$)
  ' Ondulation animee du texte jusqu'a ENTREE ou BACKSPACE.
  ' Le fond est l'image elle-meme : un BMOVE de 7200 octets restaure les 45
  ' lignes contigues de la bande 122-166.
  ' Construit dans log% puis stab, sinon le faisceau surprend la bande entre
  ' l'effacement et le redessin.
  txt.phase&=0
  REPEAT
    BMOVE pic%+19520,log%+19520,7200 ! lignes 122 a 166
    txt.phase&=SUCC(txt.phase&)
    ' Les 2 lignes ont des courbes DIFFERENTES : l'artiste ondule en vague
    ' longue, le titre en vague 2X plus serree et en phase opposee.
    ' L'ensemble parait bien plus vivant qu'avec 2 ondulations identiques.
    @txt.ligne(a1$,130,1,0)
    @txt.ligne(a2$,150,2,8)
    VSYNC ! une trame de plus : l'animation tourne a 25 Hz
    stab
    matouche&=BYTE{&HFFFC02}
  UNTIL matouche&=&H39 OR matouche&=&HE ! ESPACE, ou BACKSPACE pour revenir
  @wait.release
  ' remettre les deux tampons dans le meme etat avant de rendre la main
  BMOVE pic%+19520,log%+19520,7200
  BMOVE pic%+19520,phy%+19520,7200
RETURN
.
' !>
PROCEDURE answer_display(answer1$,answer2$)
  txt.vague&=1 ! artiste et titre en texte ondule
  @wait.release ! ne pas reagir a l'appui qui vient d'abreger l'effet
  REPEAT
    matouche&=BYTE{&HFFFC02}
    VSYNC
  UNTIL matouche&=&H39 ! IF SPACE PRESSED
  @wait.release
  ' bg_erase! a FALSE : le masque REPLACE force deja chaque cellule 8x8 a la
  ' couleur 0, le bandeau ne couvrait plus que le lisere de 2 pixels autour.
  display.bitmap.txt(answer1$,32,130,TRUE,FALSE,TRUE)
  display.bitmap.txt(answer2$,32,150,TRUE,FALSE,TRUE)
  ' wait_key(&H39)   ! wait for SPACE
RETURN
.
.
.
.
' !>
PROCEDURE sndh(tune%)
  sndh.on!=TRUE
  ' SNDH Replayer for GFA
  ' Original by Swe/YesCrew
  ' Modified version by gwEm
  '  IF NOT DIM?(regsndh%())
  ' ENDIF
  regsndh%(14)=tune% ! mym
  regsndh%(7)=50
  RCALL sndhplay%+28,regsndh%()                                 !<
RETURN
.
' !>
PROCEDURE sndh.off
  ' Ne rien faire si le lecteur n'a jamais demarre : sndh.off saute dans le
  ' code machine du bloc MALLOC, et bye l'appelle aussi comme gestionnaire
  ' d'erreur, donc potentiellement avant que base_files_load ait charge quoi
  ' que ce soit a cette adresse.
  IF sndh.on!
    sndh.on!=FALSE
    sndhstop%=sndhplay%+32
    ~C:sndhstop%()
    {&H4D2}=0  ! music off
    WAVE 0,0   ! sound off
  ENDIF
RETURN
.
.
.
.
.
.*************************************************************************************************
' !>
PROCEDURE get_slide_filenames
  .
  ' Get & Store music, picture, answer text x2 for slide show loop
  RESTORE quizz
  READ nb_files&
  nb_files_max&=nb_files&
  ' ERASE file_name$()
  DIM pic_fname$(nb_files&),sndh_fname$(nb_files&),answer1$(nb_files&),answer2$(nb_files&)
  DEC nb_files&
  FOR file&=0 TO nb_files&
    READ fname$
    sndh_fname$(file&)=fname$
    READ fname$
    pic_fname$(file&)=fname$
    READ fname$
    answer1$(file&)=fname$
    READ fname$
    answer2$(file&)=fname$
    '  print file&
    '  print sndh_fname$(file&)
    '  print pic_fname$(file&)
    '  print answer1$(file&)
    '  print answer2$(file&)
    '  ~INP(2)
    '  CLS
  NEXT file& !<
RETURN
.
' !>
PROCEDURE pmul160
  ' for BMOVES, CARD and others...
  DIM t160&(200)
  t160&(0)=0
  FOR y&=1 TO 199
    t160&(y&)=ADD(160,t160&(PRED(y&)))
  NEXT y&                                         !<
RETURN
.
' !>
PROCEDURE prepfont(mono!)
  ' prepare bitmap font for display rout
  ' assume bitmap data address pointer is at font% and fmask% is reserved
  ' ADAPTATIVE PROCEDURE
  char.width&=8
  char.height&=8
  ' 48 cellules de 8x8 sur 2 rangees de 40, la derniere vide. L'espace ferme
  ' donc la liste : partout ailleurs le test est pos.char&<PRED(len.font&).
  font.chars$="!.,/0123456789:;?ABCDEFGHIJKLMNOPQRSTUVWXYZ-'() "
  len.font&=LEN(font.chars$)
  IF mono!
    BMOVE font%,phy%,16*160
    FOR y&=0 TO char.height&*2-1
      FOR x&=0 TO 320-1
        IF PTST(x&,y&)>0
          PSET x&,y&,1
        ENDIF
      NEXT x&
    NEXT y&
    BMOVE phy%,font%,16*160
  ENDIF
  DIM bitmap.char.x&(len.font&),bitmap.char.y&(len.font&) ! base of each char coordinate
  FOR char&=0 TO PRED(len.font&)
    ' bitmap.char.adr%(char&)=ADD(phy%,MUL(TRUNC(char&/char.per.line&),offset.char.line%))
    offset&=MUL(char&,char.width&)
    bitmap.char.x&(char&)=MOD(offset&,320)
    bitmap.char.y&(char&)=MUL(char.height&,TRUNC(DIV(offset&,320)))
  NEXT char&
  ' creation 'masque' affichage pour display rideau
  ' COLOR 1 est correct ici (et non 15) : COLOR utilise un index VDI, pas
  ' le registre materiel directement. Sur ST, l'index VDI 1 correspond au
  ' registre materiel 15 (voir table de vdicol|() plus bas / DATA vdicolours),
  ' donc COLOR 1 dessine bien avec les 4 plans de bits a 1 (1111), ce qui
  ' est ce qu'il faut pour laisser passer la vraie couleur de la fonte via
  ' le ET logique de RC_COPY (mode 1) plus bas dans display.bitmap.txt
  COLOR 1
  FOR eff&=0 TO 7
    LINE 0,0,eff&,7
    LINE 7,7,7-eff&,0
    RC_COPY phy%,0,0,8,8 TO fmask%,eff&*8,0
  NEXT eff&                                                        !<
RETURN
.
' !>
PROCEDURE base_files_load
  BLOAD file_name$(0),sndhplay%
  BLOAD file_name$(1),sp3%
  BLOAD file_name$(2),font%
  BLOAD file_name$(3),tune%
  ' Fonte 16x22 du scrolltext d'intro : le .PI1 est charge dans log%, encore
  ' libre a ce stade, puis on ne garde que les 66 lignes utiles sans l'entete.
  BLOAD "DATA\2P_16_22.PI1",log%
  BMOVE log%+34,fnt2%,66*160
  ' Le sheet s'arrete au 9 : la 5e case de la 3e rangee, la ou @scroll2.step
  ' va chercher le zero, ne contient qu'une annotation du graphiste, d'ou le
  ' caractere brouille. On y recopie le O de la premiere rangee, les deux
  ' glyphes sont indiscernables dans cette fonte.
  RC_COPY fnt2%,224,0,16,22 TO fnt2%,64,44
  ' Aucun remappage de plans : le sheet est deja peint dans la palette de
  ' l'image d'intro, sur les registres 5, 7 et 9 (du sombre au clair). Il a
  ' tenu un temps sur 2 plans avec ses propres gris, ce qui obligeait a
  ' sacrifier trois registres de l'image ; ce n'est plus le cas.
  ' Corollaire : les deux .PI1 doivent garder la meme palette.
  ' Start pic load
  RESTORE intro_pic
  READ intro_pic_name$
  ldpic(intro_pic_name$,pic%,FALSE)  !<
RETURN
.
.
.
.*************************************************************************************************
.
' !>
PROCEDURE clearpal
  ' all colours to 0
  BMOVE stzpal%,&HFFFF8240,32               !<
RETURN
.
' !>
PROCEDURE clampcol
  ' Borne cr&/cv&/cb& puis les encode en quartets STE dans nr&/nv&/nb&.
  ' Quartet STE = LSB en bit 3 plus les 3 bits de poids fort ; sur STF le bit 3
  ' est ignore, la valeur reste correcte.
  IF cr&<0
    cr&=0
  ENDIF
  IF cv&<0
    cv&=0
  ENDIF
  IF cb&<0
    cb&=0
  ENDIF
  IF cr&>15
    cr&=15
  ENDIF
  IF cv&>15
    cv&=15
  ENDIF
  IF cb&>15
    cb&=15
  ENDIF
  nr&=SHL&((cr& AND 1),3)+SHR&(cr&,1)
  nv&=SHL&((cv& AND 1),3)+SHR&(cv&,1)
  nb&=SHL&((cb& AND 1),3)+SHR&(cb&,1)
RETURN
.
PROCEDURE fadeoff
  paloff%=&HFFFF8240
  ' fadeoff palette
  ' Take care : using floatint point var !
  FOR c&=0 TO 15 ! decode & store rvb components
    ' Decodage STE : le 4e bit de chaque composante est le bit de POIDS FAIBLE,
    ' mais il est stocke en TETE du quartet (....rRRR gGGGbBBB). L'ancien AND 7
    ' jetait ce bit : le fondu travaillait sur 8 niveaux au lieu de 16 et ne
    ' retombait pas exactement sur la couleur de l'image. Sur STF le materiel
    ' ignore le bit 3, le comportement y reste donc correct.
    col&=CARD{paloff%+c&+c&}
    n&=SHR(col&,8) AND 15
    r&(c&)=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
    n&=SHR(col&,4) AND 15
    v&(c&)=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
    n&=col& AND 15
    b&(c&)=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
  NEXT c&
  ' Fondu SIMULTANE des trois composantes.
  '
  ' Les trois composantes evoluent desormais ensemble : c'est une vraie
  ' rampe de luminosite decroissante. 25 pas (0 a 24) pour conserver la duree d'origine
  ' (24 VSYNC). MUL/DIV coutent ici ~1 ms par pas, negligeable dans une
  ' trame de 20 ms, et il n'y a plus aucun flottant, donc plus d'arrondi
  ' imprevisible.
  FOR i&=0 TO 24
    j&=24-i&
    FOR ii&=0 TO 15
      cr&=DIV(ADD(MUL(r&(ii&),j&),12),24)
      cv&=DIV(ADD(MUL(v&(ii&),j&),12),24)
      cb&=DIV(ADD(MUL(b&(ii&),j&),12),24)
      @clampcol
      ipal&(ii&)=OR(SHL(nr&,8),OR(SHL(nv&,4),nb&))
    NEXT ii&
    VSYNC
    FOR ii&=0 TO 15  ! change colours
      CARD{&HFFFF8240+ii&+ii&}=ipal&(ii&)
    NEXT ii&
    VSYNC ! second VSYNC : porte le fondu de 0,5 s a 1 s, plus lisible
  NEXT i&
  ' !<
RETURN
.
' !>
PROCEDURE fadereg0
  ' Monte le seul registre 0, du noir vers sa valeur dans pal%.
  ' Appele APRES pixelisation : l'image occupe deja l'ecran, seules les
  ' zones de fond s'eclaircissent. 13 paliers suffisent, c'est discret.
  LOCAL k&,w&,r0&,v0&,b0&
  w&=CARD{pal%}
  n&=SHR(w&,8) AND 15
  r0&=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
  n&=SHR(w&,4) AND 15
  v0&=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
  n&=w& AND 15
  b0&=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
  FOR k&=0 TO 12
    cr&=DIV(ADD(MUL(r0&,k&),6),12)
    cv&=DIV(ADD(MUL(v0&,k&),6),12)
    cb&=DIV(ADD(MUL(b0&,k&),6),12)
    @clampcol
    VSYNC
    CARD{&HFFFF8240}=OR(SHL(nr&,8),OR(SHL(nv&,4),nb&))
  NEXT k&
RETURN
.
PROCEDURE fadeon
  ' fadeon palette at adress pal%
  ' Take care : using floatint point var !
  ' DIM r&(16),v&(16),b&(16),dr(16),dv(16),db(16) ! final rvb component then fp offset
  ' DIM ipal&(16) ! intermediate calculated pal
  FOR c&=0 TO 15 ! decode & store rvb components
    ' Decodage STE : le 4e bit de chaque composante est le bit de POIDS FAIBLE,
    ' mais il est stocke en TETE du quartet (....rRRR gGGGbBBB). L'ancien AND 7
    ' jetait ce bit : le fondu travaillait sur 8 niveaux au lieu de 16 et ne
    ' retombait pas exactement sur la couleur de l'image. Sur STF le materiel
    ' ignore le bit 3, le comportement y reste donc correct.
    col&=CARD{pal%+c&+c&}
    n&=SHR(col&,8) AND 15
    r&(c&)=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
    n&=SHR(col&,4) AND 15
    v&(c&)=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
    n&=col& AND 15
    b&(c&)=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
  NEXT c&
  ' Fondu SIMULTANE des trois composantes.
  '
  ' Les trois composantes evoluent desormais ensemble : c'est une vraie
  ' rampe de luminosite. 25 pas (0 a 24) pour conserver la duree d'origine
  ' (24 VSYNC). MUL/DIV coutent ici ~1 ms par pas, negligeable dans une
  ' trame de 20 ms -- et il n'y a plus aucun flottant, donc plus d'arrondi
  ' imprevisible.
  ' Le registre 0 est EXCLU du fondu : au moment ou fadeon est appele,
  ' l'ecran vient d'etre efface, il est donc entierement en couleur 0.
  ' Faire monter ce registre revient a laver tout l'ecran de la couleur de
  ' fond de l'image -- flagrant sur 10.PI1 (RGB 7,3,2), 29 et 08. Il est
  ' monte separement par @fadereg0, apres que pixelisation a dessine
  ' l'image : seules les zones de fond changent alors, ce qui est discret.
  FOR i&=0 TO 24
    FOR ii&=1 TO 15
      ' ADD ...,12 = arrondi au plus proche. Avec la troncature, une
      ' composante faible (2 sur 15) restait a 0 pendant la moitie du fondu
      ' puis rattrapait d'un coup : d'ou un debut qui paraissait lent et une
      ' fin rapide.
      cr&=DIV(ADD(MUL(r&(ii&),i&),12),24)
      cv&=DIV(ADD(MUL(v&(ii&),i&),12),24)
      cb&=DIV(ADD(MUL(b&(ii&),i&),12),24)
      @clampcol
      ipal&(ii&)=OR(SHL(nr&,8),OR(SHL(nv&,4),nb&))
    NEXT ii&
    VSYNC
    FOR ii&=1 TO 15  ! change colours
      CARD{&HFFFF8240+ii&+ii&}=ipal&(ii&)
    NEXT ii&
    VSYNC ! second VSYNC : porte le fondu de 0,5 s a 1 s, plus lisible
  NEXT i&
  ' ERASE ipal&(),r&(),v&(),b&(),dr(),dv(),db()                   !<
RETURN
.
' !>
PROCEDURE dboff
  ' double buffering off
  ~XBIOS(5,L:phy%,L:phy%,-1)      !<
RETURN
.
' !>
PROCEDURE stab
  SWAP phy%,log% ! exchange adresses to display screen you just worked on
  ~XBIOS(5,L:log%,L:phy%,-1) ! set the screens at these new adresses
  '  CARD{&HFFFF8240}=&H421 ! to check which part of the vbl is used
  VSYNC ! wait 4 whole screen to be displayed       !<
RETURN
.
' !>
PROCEDURE blitter(switch!)
  status&=XBIOS(64,-1)
  IF BTST(status&,1)           ! Blitter available?
    IF switch!
      status&=BSET(status&,0)   ! Blitter on
    ELSE
      status&=BCLR(status&,0)   ! Blitter off
    ENDIF
    ~XBIOS(64,status&)         ! do it
  ENDIF !<
RETURN
.
' !>
PROCEDURE wait_key(code&)
  ' &H39=SPACE  &H1C=RETURN  &H0E=BACKSPACE
  ' Wait for specific key press & release
  REPEAT
  UNTIL BYTE{&HFFFC02}=code&
  WHILE PEEK(&HFFFC02)=code&
  WEND                                 !<
RETURN
.
' !>
PROCEDURE super
  .
  sup%=GEMDOS(32,L:0)                       !<
RETURN
.
'  !>
PROCEDURE user
  .
  ~GEMDOS(32,L:super%)                             !<
RETURN
.
PROCEDURE vdicol
  ' use gemcol|(couleur) with deffill, defftext, defmark, color, etc.
  ' to match vdi colours with linea or physical palette of video shifter &hffff8240
  RESTORE vdicolours
  FOR i|=0 TO 15
    READ vdicol|(i|)
  NEXT i|
vdicolours:
  DATA 0,2,3,6,4,7,5,8,9,10,11,14,12,15,13,1
RETURN
.
PROCEDURE txt(x&,y&,t$,t!)
  IF t!
    VSETCOLOR 1,&H223
    VSETCOLOR 2,&H334
  ENDIF
  DEFTEXT 1,16,1,15,15
  TEXT x&,y&,t$
  DEFTEXT 2
  TEXT x&+1,y&+1,t$
  CLR x&,y&,t$
RETURN
.
FUNCTION cptst(x&,y&,adr_scr%)
  LOCAL adr_ligne%,bloc_offset&,bitpos&,mask&,col&
  adr_ligne%=adr_scr%+t160&(y&)+SHL&(SHR&(x&,4),3)
  bitpos&=15-AND(x&,15)
  mask&=SHL&(1,bitpos&)
  col&=0
  ' Plan 0 = 1er mot = bit de POIDS FAIBLE (LSB). Les poids etaient inverses
  ' (plan 0 -> 8), ce qui rendait cptst/cpset coherents entre eux pour une
  ' recopie de pixel, mais faux des qu on leur passe un vrai numero de
  ' registre : recolor_font(ink_col&) peignait la fonte en bit-inverse
  ' (1->8, 2->4, 4->2). Seuls 0, 6, 9 et 15 etaient invariants - d ou une
  ' fonte d origine en 15 qui semblait correcte.
  IF (CARD{adr_ligne%} AND mask&)
    col&=col& OR 1
  ENDIF
  IF (CARD{adr_ligne%+2} AND mask&)
    col&=col& OR 2
  ENDIF
  IF (CARD{adr_ligne%+4} AND mask&)
    col&=col& OR 4
  ENDIF
  IF (CARD{adr_ligne%+6} AND mask&)
    col&=col& OR 8
  ENDIF
  RETURN col&
ENDFUNC
.
PROCEDURE cpset(x&,y&,adr_scr%,color|)
  LOCAL adr_ligne%,bloc_offset&,bitpos&,mask&,notmask&
  adr_ligne%=adr_scr%+t160&(y&)+SHL&(SHR&(x&,4),3)
  mask&=SHL&(1,15-AND(x&,15))
  notmask&=NOT mask&
  ' Meme correction de poids que dans cptst : plan 0 = LSB.
  IF (color| AND 1)
    CARD{adr_ligne%}=CARD{adr_ligne%} OR mask&
  ELSE
    CARD{adr_ligne%}=CARD{adr_ligne%} AND notmask&
  ENDIF
  ADD adr_ligne%,2
  IF (color| AND 2)
    CARD{adr_ligne%}=CARD{adr_ligne%} OR mask&
  ELSE
    CARD{adr_ligne%}=CARD{adr_ligne%} AND notmask&
  ENDIF
  ADD adr_ligne%,2
  IF (color| AND 4)
    CARD{adr_ligne%}=CARD{adr_ligne%} OR mask&
  ELSE
    CARD{adr_ligne%}=CARD{adr_ligne%} AND notmask&
  ENDIF
  ADD adr_ligne%,2
  IF (color| AND 8)
    CARD{adr_ligne%}=CARD{adr_ligne%} OR mask&
  ELSE
    CARD{adr_ligne%}=CARD{adr_ligne%} AND notmask&
  ENDIF
RETURN
.
PROCEDURE fpset(x&,y&,adr_scr%)
  ' set a pixel at x,y in the screen buffer adr_scr% at color 1
  adr%=ADD(adr_scr%,ADD(AND(SHR(x&,1),65528),t160&(y&)))
  dec%=SHR(32768,(x& AND &HF))
  CARD{adr%}=CARD{adr%} OR dec%
RETURN
.
FUNCTION fptst(x&,y&,adr_scr%)
  ' PTST a nimporte quelle adresse - code en aveugle - a tester, pixel =0 ou +
  ADD adr_scr%,ADD(SHL&(SHR&(x&,5),4),t160&(y&))
  CARD{adr_scr%}=CARD{adr_scr%} OR SHL&(1,x& AND 15)
  RETURN (CARD{adr_scr%} AND SHL&(1,x& AND 15))<>0
ENDFUNC
.
PROCEDURE area.lines.erase(x1&,y1&,x2&,y2&)
  ' ERASE A RECTANGULAR AREA OF THE SCREEN BY VERTICAL CROSS STEP2 LINES
  IF x1&>x2&
    SWAP x1&,x2&
  ENDIF
  IF y1&>y2&
    SWAP y1&,y2&
  ENDIF
  w&=x2&-x1&
  h&=y2&-y1&
  IF EVEN(h&)
    INC y2&
  ENDIF
  ' box_col& est un index de REGISTRE MATERIEL (calcule depuis pal%) ;
  ' COLOR attend un index VDI, d'ou la conversion par vdicol|() (voir @vdicol)
  COLOR vdicol|(box_col&)
  FOR y&=y1& TO y2& STEP 2
    bl&=y2&-(y&-y1&)
    LINE x1&,y&,x2&,y&
    LINE x1&,bl&,x2&,bl&
    stab
    LINE x1&,y&,x2&,y&
    LINE x1&,bl&,x2&,bl&
  NEXT y&
  stab
  ' to be sure everything is erased in the area
  DEFFILL vdicol|(box_col&)
  PBOX x1&,y1&,x2&,y2&
  VSYNC
  PBOX x1&,y1&,x2&,y2&
RETURN
.
'
' Pour un texte qui apparaissent bien (contraste) :
' Si fonte 1 couleur avec outline d'une autre couleur,
' Soit il faudrait pour chaque image :
' - independament des pixels de l'image, effacer le fond la ou le texte sera affiche avec la couleur la plus sombre
' et afficher le texte avec la couleur le plus claire de la palette (outline inutile)
' Soit scanner l'image pour voir la couleur (index) de pixel la plus frequente
' Chercher la couleur ayant le meilleur contraste avec celle ci pour redessiner la police bitmap avec cette couelur avant affichage
' Si on devait partir du principe que la couleur la plus presente est celle de fond, utiliser
' test_color_contrat avec choix=2 pour redessiner la font bitmap dans la couleur correspondante + un outline d'un contraste intermediaire
' sans quoi on est jamais sur que la fonte soit bien visible, meme avec l'outline, en mode indexe
'
' Trouve la couleur selon choix& la plus claire 0, la plus sombre 1, la plus contrastee avec le fond
PROCEDURE test_color_contrast(choix&,VAR col_number&)
  ' Programme d'analyse de palette
  ' Detecte les couleurs extremes et le contraste avec le fond.
  ' Affecte le resultat a col_number&.
  LOCAL dim_light,dim_index&
  LOCAL bright_light,bright_index&
  LOCAL max_contrast,contrast_index&
  LOCAL bg_word&,bg_r&,bg_g&,bg_b&,bg_light
  LOCAL i|,color_word&,r&,g&,b&,current_light,current_contrast
  LOCAL n&
  ' Initialisation des valeurs extremes
  dim_light=1000      ! Luminosite la plus basse trouvee
  dim_index&=-1          ! Index du registre le plus sombre
  '
  bright_light=-1     ! Luminosite la plus haute trouvee
  bright_index&=-1       ! Index du registre le plus clair
  '
  max_contrast=-1     ! Contraste maximum trouve
  contrast_index&=-1     ! Index du registre le plus contraste
  ' Obtenir la couleur de fond (Registre #0), depuis pal% (image chargee)
  bg_word&=CARD{pal%}
  ' Extraire les composantes R, G, B (0-15)
  ' PALETTE STE : le 4e bit de chaque composante est le bit de POIDS FAIBLE,
  ' mais il est stocke en TETE du quartet (....rRRR gGGGbBBB). Lire le quartet
  ' brut donne donc une valeur bit-brouillee : $0EC5 se lit RGB(14,12,5) alors
  ' que la vraie couleur est RGB(13,9,10). Les .PI1 de ce projet SONT au format
  ' STE (les bits 11, 7 et 3 y sont utilises), donc le classement par
  ' luminosite etait calcule sur des valeurs fausses.
  ' Sur une palette ST pure (quartets 0-7) la formule rend simplement 2*n :
  ' le classement reste identique, la correction est donc sans risque.
  n&=SHR&((bg_word& AND &HF00),8)
  bg_r&=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
  n&=SHR&((bg_word& AND &HF0),4)
  bg_g&=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
  n&=(bg_word& AND &HF)
  bg_b&=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
  ' Calculer une valeur de luminosite approximative pour le fond
  ' Approximation : 'grey = 0.30*red + 0.59*green + 0.11*blue'
  bg_light=0.3*bg_r&+0.59*bg_g&+0.11*bg_b&
  ' Parcourir tous les registres de la palette (0 a 15)
  FOR i|=0 TO 15
    ' Obtenir le mot couleur pour le registre courant, depuis pal%
    color_word&=CARD{pal%+i|+i|}
    ' Extraire les composantes R, G, B (0-15) (mot &)
    ' meme decodage STE que pour le fond ci-dessus
    n&=SHR&((color_word& AND &HF00),8)
    r&=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
    n&=SHR&((color_word& AND &HF0),4)
    g&=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
    n&=(color_word& AND &HF)
    b&=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
    ' Calculer la luminosite de la couleur actuelle
    current_light=0.3*r&+0.59*g&+0.11*b&
    ' Calculer le contraste avec la couleur de fond
    current_contrast=ABS(current_light-bg_light)
    ' Mettre a jour l'index de la couleur la plus sombre
    IF current_light<dim_light
      dim_light=current_light
      dim_index&=i|
    ENDIF
    ' Mettre a jour l'index de la couleur la plus claire.
    ' Registre 0 exclu : le fond de chaque cellule de caractere est
    ' toujours force a l'index 0 par le compositage AND de RC_COPY,
    ' une encre a 0 s'y fondrait et deviendrait invisible.
    IF i|>0
      IF current_light>bright_light
        bright_light=current_light
        bright_index&=i|
      ENDIF
    ENDIF
    ' Mettre a jour l'index de la couleur la plus contrastee.
    ' On ignore le registre 0 lui-meme pour le contraste maximal.
    IF i|>0
      IF current_contrast>max_contrast
        max_contrast=current_contrast
        contrast_index&=i|
      ENDIF
    ENDIF
  NEXT i|
  '  Affectation du resultat en fonction du choix
  SELECT choix&
  CASE 0  ! Couleur la plus claire
    col_number&=bright_index&
  CASE 1 ! Couleur la plus sombre
    col_number&=dim_index&
  CASE 2 ! Couleur la plus contrastee avec le fond
    col_number&=contrast_index&
  DEFAULT ! Choix invalide
    col_number&=-1 ! Ou une autre valeur d'erreur
  ENDSELECT
RETURN
'
PROCEDURE recolor_font(couleur&)
  ' Repeint tous les pixels d'encre de la fonte (font%) avec couleur&.
  ' Travaille directement en memoire, sans toucher a l'ecran actif.
  '
  LOCAL x&,y&,lig%,adr%,mask&,notmask&
  ' lig% avance par addition : MULS coute ~70 cycles sur 68000, ADD en coute 8.
  lig%=font%
  FOR y&=0 TO char.height&*2-1
    FOR x&=0 TO 320-1
      adr%=lig%+SHL&(SHR&(x&,4),3)
      mask&=SHL&(1,15-AND(x&,15))
      ' pixel d'encre = au moins un plan allume a cette position
      IF ((CARD{adr%} OR CARD{adr%+2} OR CARD{adr%+4} OR CARD{adr%+6}) AND mask&)
        notmask&=NOT mask&
        IF (couleur& AND 1)
          CARD{adr%}=CARD{adr%} OR mask&
        ELSE
          CARD{adr%}=CARD{adr%} AND notmask&
        ENDIF
        IF (couleur& AND 2)
          CARD{adr%+2}=CARD{adr%+2} OR mask&
        ELSE
          CARD{adr%+2}=CARD{adr%+2} AND notmask&
        ENDIF
        IF (couleur& AND 4)
          CARD{adr%+4}=CARD{adr%+4} OR mask&
        ELSE
          CARD{adr%+4}=CARD{adr%+4} AND notmask&
        ENDIF
        IF (couleur& AND 8)
          CARD{adr%+6}=CARD{adr%+6} OR mask&
        ELSE
          CARD{adr%+6}=CARD{adr%+6} AND notmask&
        ENDIF
      ENDIF
    NEXT x&
    ADD lig%,160
  NEXT y&
RETURN
'
PROCEDURE set_text_colors
  ' recalcule ink_col& et box_col& a partir de la palette pal% de
  ' l image qui vient d etre chargee, puis recolore la fonte
  ' choix 2 (et non 0) : le fond a l interieur de chaque lettre est
  ' toujours le registre 0, force par le ET logique de RC_COPY. On
  ' prend donc la couleur la plus contrastee avec CE registre, pas la
  ' plus claire dans l absolu, qui peut rester proche du fond sur une
  ' image sombre.
  test_color_contrast(2,ink_col&)
  test_color_contrast(1,box_col&)
  recolor_font(ink_col&)
RETURN
'
' Progressive image display fx
'
.
PROCEDURE scrambling(duree&)
  ' Effet 2 : les lignes de l'image partent melangees et se remettent
  ' progressivement en place.
  '
  ' Meme interface que pixelisation : duree& en trames (50 par seconde),
  ' sortie anticipee si l'espace est presse.
  '
  LOCAL i&,j&,k&,maxcycle&,cycle&,r&,temp&,seuil&,deja&,tenue&,l_source%,l_dest%
  maxcycle&=100 ! 100 cycles : 2 lignes remises en place par cycle
  tenue&=DIV(duree&,maxcycle&)
  FOR i&=0 TO 199
    lignes&(i&)=i&
  NEXT i&
  ' melange initial (Fisher-Yates)
  FOR i&=199 TO 1 STEP -1
    r&=RANDOM(i&)
    temp&=lignes&(i&)
    lignes&(i&)=lignes&(r&)
    lignes&(r&)=temp&
  NEXT i&
  ' Ordre de remise en place, lui aussi tire au sort. Sans lui les lignes
  ' etaient recalees de 0 vers 199, donc l'image se reformait du haut vers le
  ' bas au lieu d'apparaitre par lignes dispersees.
  ' ordre&() est le tableau de @random_pixels, qui le reconstruit a chaque
  ' appel : les deux effets ne tournent jamais en meme temps.
  FOR i&=0 TO 199
    ordre&(i&)=i&
  NEXT i&
  FOR i&=199 TO 1 STEP -1
    r&=RANDOM(i&)
    temp&=ordre&(i&)
    ordre&(i&)=ordre&(r&)
    ordre&(r&)=temp&
  NEXT i&
  pixl_exit&=0
  deja&=0
  FOR cycle&=1 TO maxcycle&
    seuil&=DIV(MUL(199,cycle&),maxcycle&)
    ' Balayage sur tout le tableau et non a partir de i& : les lignes deja
    ' calees ne sont plus forcement celles du haut. Une ligne calee ne risque
    ' rien, si lignes&(j&)=i& avec j& deja cale alors j&=i& et on ne fait rien.
    IF seuil&>=deja&
      FOR k&=deja& TO seuil&
        i&=ordre&(k&)
        IF lignes&(i&)<>i&
          FOR j&=0 TO 199
            IF lignes&(j&)=i&
              temp&=lignes&(i&)
              lignes&(i&)=lignes&(j&)
              lignes&(j&)=temp&
            ENDIF
            EXIT IF lignes&(i&)=i&
          NEXT j&
        ENDIF
      NEXT k&
      deja&=SUCC(seuil&)
    ENDIF
    VSYNC
    FOR i&=0 TO 199
      l_source%=pic%+t160&(lignes&(i&))
      l_dest%=phy%+t160&(i&)
      BMOVE l_source%,l_dest%,160
    NEXT i&
    @pixhold(tenue&)
    EXIT IF pixl_exit&=1
  NEXT cycle&
  IF pixl_exit&=1
    @fin.rapide(100) ! 100 trames = 2 s
  ELSE
    BMOVE pic%,phy%,32000
    BMOVE pic%,log%,32000
  ENDIF
RETURN
.
PROCEDURE random_pixels(duree&)
  ' Effet 4 : l'image apparait par blocs disperses, en ordre aleatoire.
  '
  ' Ici l'unite devoilee est un bloc de 16x4 pixels : un mot par plan sur
  ' quatre lignes, soit 8 octets par ligne et 20 x 50 = 1000 blocs. L'ordre
  ' vient d'un melange de Fisher-Yates sur 1000 mots (2 Ko) : chaque bloc est
  ' visite une fois et une seule, sans aucun rejet.
  LOCAL b&,i&,r&,temp&,tenue&,bx&,by&,off%
  tenue&=DIV(duree&,1000)
  IF tenue&<1
    tenue&=1
  ENDIF
  FOR i&=0 TO 999
    ordre&(i&)=i&
  NEXT i&
  FOR i&=999 TO 1 STEP -1
    r&=RANDOM(i&)
    temp&=ordre&(i&)
    ordre&(i&)=ordre&(r&)
    ordre&(r&)=temp&
  NEXT i&
  pixl_exit&=0
  FOR i&=0 TO 999
    b&=ordre&(i&)
    bx&=MOD(b&,20)
    by&=DIV(b&,20)
    off%=MUL(by&,640)+SHL&(bx&,3) ! 4 lignes de 160, un mot par plan
    BMOVE pic%+off%,phy%+off%,8
    ADD off%,160
    BMOVE pic%+off%,phy%+off%,8
    ADD off%,160
    BMOVE pic%+off%,phy%+off%,8
    ADD off%,160
    BMOVE pic%+off%,phy%+off%,8
    @pixhold(tenue&)
    EXIT IF pixl_exit&=1
  NEXT i&
  IF pixl_exit&=1
    @fin.rapide(100)
  ELSE
    BMOVE pic%,phy%,32000
    BMOVE pic%,log%,32000
  ENDIF
RETURN
' !>
PROCEDURE scan_pic_for_color(fast!)
  ' procedure de scan des index de couleur de chaque pixel de l'ecran avec
  ' analse frequentielle couleurs
  ' pour ne plus dependre des tableaux et limiter les risques de pertes de donnees
  ' array -> malloc + cards
  ' pic_colors_array%
  ' LOCAL x&,y&,adr_pix%,color|,adr_pix%
  ARRAYFILL freq%(),0
  IF fast!
    @fast_ptst_scan
  ELSE
    adr_pix%=pic_colors_array%
    FOR y&=0 TO 199
      FOR x&=0 TO 319
        ' PTST pour eviter une nelle rout custom foireuse
        color|=vdicol|(PTST(x&,y&))
        BYTE{adr_pix%}=color|
        INC freq%(color|)
        INC adr_pix%
      NEXT x&
    NEXT y&
  ENDIF
  '
  ' Trouve les 2 valeurs min / max et index correspondants du tableau de frequence
  ' Initialisations
  most1_val%=-65000     ! 65000 > 64000 max pixels in screen
  most2_val%=-65000
  most1_index&=-1
  most2_index&=-1
  '
  least1_val%=65000
  least2_val%=65000
  least1_index&=-1
  least2_index&=-1
  '
  ' Analyse du tableau
  i&=0
  WHILE i&<=15
    v%=freq%(i&)
    '
    ' Recherche des 2 plus grands
    IF v%>most1_val%
      most2_val%=most1_val%
      most2_index&=most1_index&
      most1_val%=v%
      most1_index&=i&
    ELSE
      IF v%>most2_val%
        most2_val%=v%
        most2_index&=i&
      ENDIF
    ENDIF
    '
    ' Recherche des 2 plus petits
    IF v%<least1_val%
      least2_val%=least1_val%
      least2_index&=least1_index&
      least1_val%=v%
      least1_index&=i&
    ELSE
      IF v%<least2_val%
        least2_val%=v%
        least2_index&=i&
      ENDIF
    ENDIF
    '
    INC i&
  WEND
RETURN
.
PROCEDURE fast_ptst_scan
  .
  ' methode directe de decodage plan de bits pour obtention index de couleur
  .
  image_pixel_color_index%=pic_colors_array%
  y&=0
  baseadr%=pic%
  adr_ligne%=baseadr%
  WHILE y&<200
    x&=0
    adr_bloc%=adr_ligne%
    base_offset%=image_pixel_color_index%+SHL(y&,8)+SHL(y&,6)   ! y*320 = (y<<8)+(y<<6)
    WHILE x&<320
      p0&=CARD{adr_bloc%}
      p1&=CARD{adr_bloc%+2}
      p2&=CARD{adr_bloc%+4}
      p3&=CARD{adr_bloc%+6}
      i&=0
      m&=&H8000 ! eqv &X1000000000000000    ! masque = bit 15
      WHILE i&<16
        ' bit0&=WORD(BTST(p0%,i&)) ! FASTER ?
        col&=0
        IF (p0& AND m&)
          INC col&
        ENDIF
        IF (p1& AND m&)
          ADD col&,2
        ENDIF
        IF (p2& AND m&)
          ADD col&,4
        ENDIF
        IF (p3& AND m&)
          ADD col&,8
        ENDIF
        CARD{base_offset%+x&+i&}=col&
        INC freq%(col&)
        m&=SHR(m&,1)
        INC i&
      WEND
      ADD adr_bloc%,8     ! chaque bloc = 8 octets (4 mots)
      ADD x&,16
    WEND
    ADD adr_ligne%,160
    INC y&
  WEND
RETURN
.
'
' *************************************************************************************************
' *                          OPTIONNELS - NON UTILISES                                            *
' *************************************************************************************************
' Procedures conservees mais qu'aucun chemin n'appelle. Elles peuvent resservir ;
' les defauts connus sont signales sur place.
.
' !>
PROCEDURE pal.order.by.lum
  ' Range les 16 index de la palette materielle du plus clair au plus sombre
  ' dans ord.pal&(). Personne ne l'appelle : test_color_contrast fait le tri
  ' dont le programme a besoin, directement depuis pal%.
  ' Trois corrections : les affectations de fin de passe etaient DANS la boucle
  ' interne et detruisaient le tableau pendant le balayage ; la lecture partait
  ' du registre 1 en stockant l'indice 0 ; AND 7 jetait le 4e bit des
  ' composantes STE (cf. @fadeon).
  ' Un seul appel : le DIM ci-dessous echouerait au second. Deplacer les deux
  ' DIM dans @hello si le besoin d'appels repetes se presente.
  LOCAL c&,r2&,col&,rr&,vv&,bb&,n&,max&,vax&
  DIM bas.pal&(15),ord.pal&(15)
  FOR c&=0 TO 15
    col&=CARD{&HFFFF8240+c&+c&}
    n&=SHR(col&,8) AND 15
    rr&=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
    n&=SHR(col&,4) AND 15
    vv&=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
    n&=col& AND 15
    bb&=SHL&((n& AND 7),1)+SHR&((n& AND 8),3)
    ' Luminance ponderee : le vert pese le plus, le bleu le moins.
    bas.pal&(c&)=MUL(rr&,3)+MUL(vv&,6)+bb&
  NEXT c&
  FOR c&=0 TO 15
    max&=-1
    vax&=0
    FOR r2&=0 TO 15
      IF bas.pal&(r2&)>max&
        max&=bas.pal&(r2&)
        vax&=r2&
      ENDIF
    NEXT r2&
    ord.pal&(c&)=vax&
    bas.pal&(vax&)=-2 ! marquee comme deja classee
  NEXT c&
RETURN
.
' !>
.
PROCEDURE create_outline_font(width&,height&,color_filled&,color_outline&)
  ' Entoure d'un contour color_outline& les pixels non nuls du rectangle
  ' (1,1)-(width&-2,height&-2), et repeint le texte en color_filled&.
  ' Couleurs en index VDI, pas en registre materiel : passer vdicol|(reg).
  ' Le contour est trace pendant le balayage : sans le test <>color_outline&
  ' ci-dessous, les pixels de contour deja poses seraient relus comme du texte
  ' et le contour s'epaissirait de proche en proche. color_outline& ne doit donc
  ' pas figurer dans le glyphe d'origine, et doit differer de color_filled&.
  ' Lent : PTST/PSET passent par le VDI. Pour la fonte 8x8, prevoir un passage
  ' par plans de bits (cf. @pixdraw) si l'effet est retenu.
  LOCAL x&,y&,dx&,dy&,p&
  FOR y&=1 TO height&-2
    FOR x&=1 TO width&-2
      p&=PTST(x&,y&)
      IF p&<>0 AND p&<>color_outline&
        PSET x&,y&,color_filled&
        FOR dy&=-1 TO 1
          FOR dx&=-1 TO 1
            IF dx&<>0 OR dy&<>0 ! le centre vient d'etre trace
              IF PTST(x&+dx&,y&+dy&)=0
                PSET x&+dx&,y&+dy&,color_outline&
              ENDIF
            ENDIF
          NEXT dx&
        NEXT dy&
      ENDIF
    NEXT x&
  NEXT y&
RETURN
'
PROCEDURE slow_fadeon
  ' Fondu plus lent que @fadeon, non ecrit. @fadeon fait 25 paliers de deux
  ' VSYNC, soit une seconde : pour l'allonger, ajouter des VSYNC dans sa
  ' boucle. Monter au-dela de 25 paliers n'apporterait rien, la palette n'ayant
  ' que 16 niveaux par composante.
RETURN
.
