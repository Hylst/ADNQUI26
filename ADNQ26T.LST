' !>
PROCEDURE display.bitmap.txt(text$,xb&,yb&,horizontal!,bg_erase!,center!)
  ' DISPLAY TEXT AT X, Y COORDINATES (UP-LEFT) WITH BITMAP FONT
  ' ! no clipping ! one line only (no carriage return) bombs if text >39 chars
  ' lost machine time should be use for precalc or have to put under interrupt
  ' centrage
  len.text&=PRED(LEN(text$))
  IF len.text&>38
    text$=LEFT$(text$,38)  ! tronquage...
    len.text&=PRED(LEN(text$)) ! max 40 chars
  ENDIF
  IF center!
    xb&=160-(len.text&+1)*char.width&/2
  ENDIF
  IF bg_erase!
    area.lines.erase(xb&-2,yb&-2,xb&+(1+len.text&)*char.width&+2,yb&+char.height&) ! erase area for text
  ENDIF
  FOR char&=1 TO SUCC(len.text&)
    pos.char&=PRED(INSTR(font.chars$,MID$(text$,char&,1)))
    IF (pos.char&<43)
      FOR m.appear&=0 TO 7*8 STEP 8
        IF horizontal!
          RC_COPY fmask%,m.appear&,0,8,8 TO log%,ADD(xb&,MUL(PRED(char&),char.width&)),yb&
          RC_COPY font%,bitmap.char.x&(pos.char&),bitmap.char.y&(pos.char&),char.width&,char.height& TO log%,ADD(xb&,MUL(PRED(char&),char.width&)),yb&,1
        ELSE
          RC_COPY fmask%,m.appear&,0,8,8 TO log%,xb&,ADD(yb&,MUL(PRED(char&),char.width&))
          RC_COPY font%,bitmap.char.x&(pos.char&),bitmap.char.y&(pos.char&),char.width&,char.height& TO log%,xb&,ADD(yb&,MUL(PRED(char&),char.width&)),1
        ENDIF
        stab
      NEXT m.appear&
      PAUSE 1
    ENDIF
  NEXT char&                                               !<
RETURN
.
' !>
PROCEDURE ldpic(fname$,adr%,spk!)
  IF spk!
    BLOAD fname$,adr% ! for speedpacker decrunch
    ' spk ! speed packer decrunching
    BMOVE adr%+2,pal%,32
    BMOVE adr%+34,adr%,32000
  ELSE
    OPEN "I",#1,fname$
    SEEK #1,2                  ! skip resolution
    BGET #1,pal%,32            ! load palette of picture
    SEEK #1,34
    BGET #1,adr%,32000         ! load actual picture
    CLOSE #1
  ENDIF                        !<
RETURN
.
' !>
PROCEDURE dysplay_text_shuffle(background%,text%)
  FOR i&=0 TO 199
    lignes&(i&)=i&
  NEXT i&
  ' Melange de Fisher-Yates
  FOR i&=199 TO 1 STEP -1
    j&=RANDOM(i&)
    SWAP lignes&(i&),lignes&(j&)
  NEXT i&
  ' Copier l’image de fond dans les deux buffers une fois
  RC_COPY background%,0,0,320,200 TO log%,0,0,7
  RC_COPY background%,0,0,320,200 TO phy%,0,0,7
  ' --- Boucle d’affichage progressif
  i&=0
  WHILE i&<200
    y&=lignes&(i&)
    ' Ajouter la ligne courante
    RC_COPY text%,0,y&,320,1 TO log%,0,y&,7
    IF i&>0
      yprev&=lignes&(i&-1)
      RC_COPY text%,0,yprev&,320,1 TO log%,0,yprev&,7
    ENDIF
    ' Affichage synchro
    VSYNC
    ~XBIOS(5,L:log%,L:phy%,-1)
    SWAP log%,phy%
    INC i&
  WEND
RETURN
'
PROCEDURE tatouche
  tatouche&=BYTE{&HFFFFC02}
  IF tatouche&=&H39
    pixl_exit&=1
  ENDIF
RETURN
'
PROCEDURE pixelisation(box!)
  ' Effet 1: Pixelisation progressive
  ' L'image commence tres pixelisee et devient de plus en plus nette
  ' la gestion de duree n'est pas utile ici, l'affchage etant de toute fa�on trs lent a coup de rec copy au pixel pret
  ' duree&=1 ! valeur arbitraire de temps
  maxcycle&=32  ! Nombre total de cycles (etapes de progression)
  '  delay&=duree&/maxcycle&  ! Delai entre chaque cycle pour un total de 'duree%' secondes
  pixl_exit&=0
  FOR cycle&=1 TO maxcycle&
    ' Calcul de la taille des blocs (commence grand, finit a 1 pixel)
    ' taille&=320/((319*cycle&/maxcycle&)+1)
    taille&=2^(5-cycle&/(maxcycle&/5))  ! exponentielle soft pour arrivé à 1 - vite
    IF taille&<1
      taille&=1
    ENDIF
    @tatouche
    EXIT IF pixl_exit&=1
    ' Parcours de l'image par blocs
    FOR y&=0 TO 199 STEP taille&
      bloc_h&=taille&
      IF y&+bloc_h&>199
        bloc_h&=200-y&
      ENDIF
      @tatouche
      EXIT IF pixl_exit&=1
      FOR x&=0 TO 319 STEP taille&
        bloc_l&=taille&
        IF x&+bloc_l&>319
          bloc_l&=320-x&
        ENDIF
        @tatouche
        EXIT IF pixl_exit&=1
        ' Pour chaque bloc, on determine la couleur dominante du bloc source
        ' Mais couleurs indexees ici, sans rampe de couleur continue
        ' On Simplifie ici, on prend juste le premier pixel du bloc
        ' Pour une version plus precise, il faudrait analyser tout le bloc
        ' Copie du premier pixel du bloc source vers tout le bloc destination
        IF box!
          ' alternative pbox
          DEFFILL ! BYTE{pic_colors_array%+2*t160&(y&)+x&}
          PBOX x&,y&,x&+bloc_l&-1,y&+bloc_h&-1
        ELSE
          ' pixel par pixel
          FOR j&=0 TO bloc_h&-1 STEP 4
            @tatouche
            EXIT IF pixl_exit&=1
            FOR i&=0 TO bloc_l&-1 STEP 4
              RC_COPY pic%,x&,y&,4,4 TO phy%,x&+i&,y&+j&
              @tatouche
              EXIT IF pixl_exit&=1
            NEXT i&
          NEXT j&
        ENDIF
      NEXT x&
    NEXT y&
    IF box!
      stab
    ENDIF
    @tatouche
    EXIT IF (pixl_exit&=1) OR (cycle&>16)
  NEXT cycle&
  @scrambling
  BMOVE pic%,phy%,32000
  BMOVE phy%,log%,32000
RETURN
.
' !>
PROCEDURE answer_display(answer1$,answer2$)
  REPEAT
    matouche&=BYTE{&HFFFC02}
    VSYNC
  UNTIL matouche&=&H39 ! IF SPACE PRESSED
  display.bitmap.txt(answer1$,32,130,TRUE,TRUE,TRUE)
  display.bitmap.txt(answer2$,32,150,TRUE,TRUE,TRUE)
  ' wait_key(&H39)   ! wait for SPACE
RETURN
.
.
.
